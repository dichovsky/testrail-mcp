  "sources": [
    {
      "id": "driver-module-labels",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/labels.ts",
      "supports": "Every method validates its identifier and places it as the only path segment of the matching endpoint. updateLabel additionally validates payload.project_id, and deleteLabels checks that label_ids is a non-empty array and validates every member, so those two payload rules are the driver's rather than the boundary's alone. The reads parse against LabelSchema, the two writes against LabelWriteResponseSchema, and the two deletes pass no schema and resolve with no value."
    },
    {
      "id": "driver-schema-labels",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/labels.ts",
      "supports": "LabelSchema carries id, title, name, created_by and created_on, with created_by a union of number and string because the reference quotes it while leaving created_on unquoted. LabelWriteResponseSchema is a union of that flat label and an object wrapping it under a label key, which it transforms to the flat form, so a mutation resolves with one shape whichever TestRail sends. AddLabelPayloadSchema carries a required title, and its comment records that TestRail's 20-character cap is deliberately left to the server. UpdateLabelPayloadSchema requires a positive project_id and a title. DeleteLabelsPayloadSchema requires a non-empty array of positive label_ids."
    },
    {
      "id": "driver-paginated-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts",
      "supports": "The shared executor issues the page request with the caller's controls, and the all helper walks the envelope's next link under the supplied bounds."
    },
    {
      "id": "driver-pagination",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts",
      "supports": "The aggregate bounds maxItems, maxPages, maxBytes and maxDurationMs stop the walk and are never serialized upstream."
    },
    {
      "id": "driver-url",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts",
      "supports": "Query parameters are appended path-style after the endpoint token, each value percent encoded."
    },
    {
      "id": "testrail-labels",
      "url": "https://support.testrail.com/hc/en-us/articles/38961149782036-Labels",
      "supports": "The reference documents get_label, get_labels and update_label only. get_labels takes the project plus limit and offset and no other filter. update_label takes project_id and title, both required, and caps the title at 20 characters. It documents neither add_label, delete_label nor delete_labels, so those three rest on the driver and on the official TestRail CLI."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "The only list in this family that takes no filter of its own: TestRail's reference gives it the project plus limit and offset, and the driver's prepare step passes only the project. A caller asking to narrow the result by title is refused rather than served a wider list, which is why every unknown query field is rejected."
  },
  "outer_result": {
    "driver": "page",
    "tool_data": "array",
    "notes": "Page mode returns the driver's decoded page and all mode the collected array; entity-field drift is advisory."
  },
