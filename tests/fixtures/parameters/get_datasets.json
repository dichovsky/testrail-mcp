      "id": "unknown-query",
      "kind": "invalid",
      "description": "Reject any query key. The endpoint documents no request controls, so a limit or an offset here is a caller mistake rather than a filter."
    },
    {
      "id": "unknown-control",
      "kind": "invalid",
      "description": "Reject an unknown _mcp control rather than discarding it."
    },
    {
      "id": "no-request-controls",
      "kind": "mapping",
      "description": "Send the project alone. Neither mode appends a limit or an offset, since the endpoint documents none."
    }
  ],
