  "endpoint": {
    "family_id": "T09",
    "http_method": "GET",
    "route": "get_datasets/{project_id}",
    "tool": "testrail_get_datasets",
    "driver_method": "datasets.getDatasets"
  },
  "sources": [
    {
      "id": "driver-module-datasets",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/datasets.ts",
      "supports": "DATASETS_PAGINATION is declared with requestControls false and an envelope response over the datasets collection, and its prepare step contributes the project alone as a path parameter. Neither getDatasetsPage nor getAllDatasets therefore sends a limit or an offset: the page helper takes the project alone and the aggregate takes it with the safety bounds. prepare validates the project identifier, so an invalid one is refused before any request."
    },
    {
      "id": "driver-paginated-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts",
      "supports": "An executor declared without request controls appends neither a limit nor an offset to the page request, and its aggregate is built on the envelope-only branch whose options type excludes pageSize and startOffset outright. The all helper copies only maxPages, maxItems, maxDurationMs and maxBytes."
    },
    {
      "id": "driver-pagination",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts",
      "supports": "The safety bounds are named maxItems, maxPages, maxBytes and maxDurationMs, and a page is normalized to a kind discriminator beside the decoded items, carrying the envelope's own offset, limit, size and links through."
    },
    {
      "id": "driver-schema-datasets",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/datasets.ts",
      "supports": "The list endpoint wraps dataset objects in the standard bulk envelope, which the module unwraps before parsing, so DatasetSchema models one dataset. id and name are required scalars, variables is nullish, and each entry's value is nullable."
    },
    {
      "id": "testrail-datasets",
      "url": "https://support.testrail.com/hc/en-us/articles/7077300491540-Datasets",
      "supports": "get_datasets lists the datasets of a project. Its parameter table carries project_id alone and marks it required, documenting no limit, offset or page control, while the example reply carries the bulk pagination fields offset, limit, size and _links beside a datasets array whose entries match get_dataset. The documented failures are 400 for an invalid or missing project_id, 401 for authentication failure, and 403 for insufficient project permissions or \"Not an Enterprise license/subscription\"."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth. The endpoint documents no request controls, so this tool offers none: the server chooses each page, and the caller may only bound how much of it the aggregate collects."
  },
  "outer_result": {
    "driver": "page",
    "tool_data": "array",
    "notes": "Page mode returns the server-selected page as the driver decoded it. Because the endpoint takes no controls, a continuation cannot be requested by offset and the wrapper says so; the bounded aggregate is the way to read further. All mode returns the collected array, and an aggregate that stops at one of its bounds cannot be resumed from where it stopped: there is no offset to start from, so reading further means raising the bound rather than continuing."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
