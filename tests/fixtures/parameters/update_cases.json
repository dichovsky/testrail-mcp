{
  "schema_version": 1,
  "review": { "status": "complete", "pending": [], "driver_version": "7.2.0", "driver_commit": "cc7751c01c3d3956d061073283bee6b23bf33422", "reviewed_on": "2026-09-19" },
  "endpoint": { "family_id": "T02", "http_method": "POST", "route": "update_cases/{suite_id}", "tool": "testrail_update_cases", "driver_method": "cases.updateCases" },
  "sources": [
    { "id": "driver-module", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/cases.ts", "supports": "updateCases validates the suite ID, sends it as the only path segment of update_cases, forwards the JSON payload unchanged in one request, unwraps TestRail's { updated_cases: [...] } reply, and fails closed with a status-200 API error when a successful reply has any other shape, because the write may already have happened. The driver notes that suite_id is required even in single-suite mode." },
    { "id": "driver-schema", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/cases.ts", "supports": "The case payload schemas declare title, template_id, type_id, priority_id, estimate, milestone_id, refs, labels (numbers or strings), is_legacy and a legacy custom_fields record; update payloads add section_id and the bulk update requires case_ids. Every identifier is a plain number in the driver." },
    { "id": "driver-common", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/common.ts", "supports": "zObject uses passthrough, so the driver forwards unknown and custom_* properties alike; the MCP boundary must reject ordinary unknown names separately." },
    { "id": "testrail-cases", "url": "https://support.testrail.com/hc/en-us/articles/7077292642580-Cases", "supports": "add_case and update_case take title, template_id, type_id, priority_id, estimate (a timespan such as 30s or 1m 45s), milestone_id, refs (a comma-separated string), labels (an array of IDs or titles) and is_legacy, plus custom fields submitted with their system name prefixed with custom_. update_case supports partial updates and section_id requires TestRail 6.5.2 or later. update_cases applies the same values to every case in case_ids and add_cases takes an array of case objects." }
  ],
  "input_policy": { "ordinary_fields": "reject", "custom_fields": "flat_custom_prefix", "notes": "Strictness is an MCP boundary requirement at every depth. Custom fields are flat custom_* properties with any JSON value; the driver's legacy custom_fields container is refused rather than forwarded because TestRail does not read it." },
  "outer_result": { "driver": "array", "tool_data": "array", "notes": "The updated cases are returned as an array, unwrapped by the driver from TestRail's updated_cases envelope; entity-field drift is advisory. An unrecognized successful reply is an INVALID_RESPONSE error whose write outcome is unknown, never a retry or a split." },
  "requirements": [
    { "id": "unknown-top-level", "kind": "invalid", "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them." },
    { "id": "unknown-body", "kind": "invalid", "description": "Reject an unknown ordinary body field rather than forwarding it; only custom_* names extend the payload." },
    { "id": "legacy-custom-container", "kind": "invalid", "description": "Reject the driver's nested custom_fields object. TestRail reads custom values only as flat custom_* properties, so forwarding the container would drop them silently." },
    { "id": "no-split", "kind": "mapping", "description": "Send exactly one request carrying every listed case. The adapter never splits the list or retries on its own." }
  ],
  "baseline": "full-body",
  "parameters": [
    { "id": "suite_id", "input_path": ["suite_id"], "scope": "path", "requiredness": "required", "domain_ref": "positive_id", "semantics": "No coercion. The suite the cases belong to, required even in single-suite mode; passed positionally and sent verbatim as the only path segment.", "driver": { "argument": 0, "path": [] }, "wire": { "location": "path", "names": ["suite_id"], "encoding": "Decimal integer path segment; numeric strings are rejected rather than coerced." }, "sources": ["driver-module", "testrail-cases"] },
    { "id": "body", "input_path": ["body"], "scope": "body", "requiredness": "required", "domain": { "type": "object" }, "semantics": "No coercion. The JSON object is passed as the driver's payload argument and sent unchanged.", "driver": { "argument": 1, "path": [] }, "wire": { "location": "json", "names": ["body"], "encoding": "JSON object sent unchanged." }, "sources": ["driver-module", "driver-schema"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve the object at driver argument 1 as the JSON request body." }, { "id": "valid", "kind": "valid", "description": "Accept an object." }, { "id": "invalid", "kind": "invalid", "description": "Reject a body that is not an object before driver invocation." }, { "id": "required", "kind": "required", "description": "Reject a missing body." } ] },
    { "id": "body.case_ids", "input_path": ["body", "case_ids"], "scope": "body", "requiredness": "required", "domain_ref": "case_ids", "semantics": "The cases to update. The driver forwards the payload unchecked, so the boundary holds every member to the identifier domain and requires at least one; the list is sent as a JSON array.", "driver": { "argument": 1, "path": ["case_ids"] }, "wire": { "location": "json", "names": ["case_ids"], "encoding": "JSON array of integers under case_ids." }, "sources": ["driver-module", "driver-schema", "testrail-cases"] },
    { "id": "body.section_id", "input_path": ["body", "section_id"], "scope": "body", "requiredness": "optional", "domain_ref": "positive_id", "semantics": "Moves the case into this section (TestRail 6.5.2 or later). The driver forwards any number, so the boundary holds it to the identifier domain; sent as a JSON number.", "driver": { "argument": 1, "path": ["section_id"] }, "wire": { "location": "json", "names": ["section_id"], "encoding": "JSON integer under section_id." }, "sources": ["driver-schema", "testrail-cases"] },
    { "id": "body.title", "input_path": ["body", "title"], "scope": "body", "requiredness": "optional", "domain": { "type": "string" }, "semantics": "The new title. No coercion; omitted leaves the title unchanged.", "driver": { "argument": 1, "path": ["title"] }, "wire": { "location": "json", "names": ["title"], "encoding": "JSON string under title." }, "sources": ["driver-schema", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve the title under its own name in the body." }, { "id": "valid", "kind": "valid", "description": "Accept a string." }, { "id": "invalid", "kind": "invalid", "description": "Reject a non-string title before driver invocation." }, { "id": "omitted", "kind": "omitted", "description": "Send no title when the caller did not supply one." } ] },
    { "id": "body.template_id", "input_path": ["body", "template_id"], "scope": "body", "requiredness": "optional", "domain_ref": "positive_id", "semantics": "The template (field layout), TestRail 5.2 or later. The driver forwards any number, so the boundary holds it to the identifier domain; sent as a JSON number.", "driver": { "argument": 1, "path": ["template_id"] }, "wire": { "location": "json", "names": ["template_id"], "encoding": "JSON integer under template_id." }, "sources": ["driver-schema", "testrail-cases"] },
    { "id": "body.type_id", "input_path": ["body", "type_id"], "scope": "body", "requiredness": "optional", "domain_ref": "positive_id", "semantics": "The case type. The driver forwards any number, so the boundary holds it to the identifier domain; sent as a JSON number.", "driver": { "argument": 1, "path": ["type_id"] }, "wire": { "location": "json", "names": ["type_id"], "encoding": "JSON integer under type_id." }, "sources": ["driver-schema", "testrail-cases"] },
    { "id": "body.priority_id", "input_path": ["body", "priority_id"], "scope": "body", "requiredness": "optional", "domain_ref": "positive_id", "semantics": "The case priority. The driver forwards any number, so the boundary holds it to the identifier domain; sent as a JSON number.", "driver": { "argument": 1, "path": ["priority_id"] }, "wire": { "location": "json", "names": ["priority_id"], "encoding": "JSON integer under priority_id." }, "sources": ["driver-schema", "testrail-cases"] },
    { "id": "body.estimate", "input_path": ["body", "estimate"], "scope": "body", "requiredness": "optional", "domain": { "type": "string" }, "semantics": "A timespan such as 30s or 1m 45s, as TestRail documents it; the format is TestRail's to check. No coercion.", "driver": { "argument": 1, "path": ["estimate"] }, "wire": { "location": "json", "names": ["estimate"], "encoding": "JSON string under estimate." }, "sources": ["driver-schema", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve the estimate under its own name in the body." }, { "id": "valid", "kind": "valid", "description": "Accept a timespan string." }, { "id": "invalid", "kind": "invalid", "description": "Reject a number of seconds in place of the string before driver invocation." }, { "id": "omitted", "kind": "omitted", "description": "Send no estimate when the caller did not supply one." } ] },
    { "id": "body.milestone_id", "input_path": ["body", "milestone_id"], "scope": "body", "requiredness": "optional", "domain_ref": "positive_id", "semantics": "The milestone to link. The driver forwards any number and admits no null, so the boundary holds it to the identifier domain; unlinking is not available through the pinned driver. Sent as a JSON number.", "driver": { "argument": 1, "path": ["milestone_id"] }, "wire": { "location": "json", "names": ["milestone_id"], "encoding": "JSON integer under milestone_id." }, "sources": ["driver-schema", "testrail-cases"] },
    { "id": "body.refs", "input_path": ["body", "refs"], "scope": "body", "requiredness": "optional", "domain": { "type": "string" }, "semantics": "A comma-separated list of references in one string, as TestRail documents it. No coercion; an array is not the documented form and is refused.", "driver": { "argument": 1, "path": ["refs"] }, "wire": { "location": "json", "names": ["refs"], "encoding": "JSON string under refs." }, "sources": ["driver-schema", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve the references string under its own name in the body." }, { "id": "valid", "kind": "valid", "description": "Accept a comma-separated string." }, { "id": "invalid", "kind": "invalid", "description": "Reject an array of references before driver invocation." }, { "id": "omitted", "kind": "omitted", "description": "Send no references when the caller did not supply them." } ] },
    { "id": "body.labels", "input_path": ["body", "labels"], "scope": "body", "requiredness": "optional", "domain": { "type": "array", "items": { "anyOf": [ { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, { "type": "string" } ] } }, "semantics": "Labels named by ID or by title, mixed freely, as TestRail documents. The driver accepts any number for an ID; the boundary holds numeric members to the identifier domain. An empty array is forwarded unchanged.", "driver": { "argument": 1, "path": ["labels"] }, "wire": { "location": "json", "names": ["labels"], "encoding": "JSON array of integers and strings under labels." }, "sources": ["driver-schema", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve every member in order under labels." }, { "id": "valid", "kind": "valid", "description": "Accept an ID and a title together." }, { "id": "empty", "kind": "valid", "description": "Accept an empty array and send it as such." }, { "id": "invalid", "kind": "invalid", "description": "Reject a boolean member before driver invocation." }, { "id": "zero-id", "kind": "invalid", "description": "Reject a label ID of zero, which can never name a label." }, { "id": "omitted", "kind": "omitted", "description": "Send no labels when the caller did not supply them." } ] },
    { "id": "body.is_legacy", "input_path": ["body", "is_legacy"], "scope": "body", "requiredness": "optional", "domain": { "type": "boolean" }, "semantics": "true marks the text fields, custom ones included, as Markdown for later conversion to rich text. No coercion.", "driver": { "argument": 1, "path": ["is_legacy"] }, "wire": { "location": "json", "names": ["is_legacy"], "encoding": "JSON boolean under is_legacy." }, "sources": ["driver-schema", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve the flag under its own name in the body." }, { "id": "valid", "kind": "valid", "description": "Accept a boolean." }, { "id": "invalid", "kind": "invalid", "description": "Reject a numeric stand-in for the boolean before driver invocation." }, { "id": "omitted", "kind": "omitted", "description": "Send no flag when the caller did not supply one." } ] },
    { "id": "body.custom_*", "input_path": ["body", "custom_*"], "scope": "body", "requiredness": "optional", "domain": {}, "semantics": "Any JSON value under a flat custom_ name, which is how TestRail reads custom fields. Values are preserved as given, including null, false, zero, arrays and nested objects; an ordinary unknown name is rejected rather than passed through.", "driver": { "argument": 1, "path": ["custom_*"] }, "wire": { "location": "json", "names": ["custom_*"], "encoding": "Flat JSON properties retained under their exact names." }, "sources": ["driver-schema", "driver-common", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve every custom_* property flat in the body." }, { "id": "valid", "kind": "valid", "description": "Accept strings, structured steps, null, zero and false." }, { "id": "invalid", "kind": "invalid", "description": "Reject an ordinary unknown key used in place of a custom_* key." }, { "id": "omitted", "kind": "omitted", "description": "Send no custom properties when the caller supplied none." } ] }
  ],
