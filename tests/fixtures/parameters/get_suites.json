  "endpoint": {
    "family_id": "T01",
    "http_method": "GET",
    "route": "get_suites/{project_id}",
    "tool": "testrail_get_suites",
    "driver_method": "suites.getSuites"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/suites.ts",
      "supports": "getSuitesPage and getAllSuites validate the project ID and place it as the only path segment; neither takes a filter. The page helper decodes one response; the all helper collects under the safety bounds."
    },
    {
      "id": "driver-paginated-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts",
      "supports": "The page helper validates limit and offset before dispatch and appends them after the path. The all helper copies only pageSize, startOffset, maxPages, maxItems, maxDurationMs and maxBytes from its options."
    },
    {
      "id": "driver-pagination",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts",
      "supports": "collectAllPages validates every bound before the first request, defaults pageSize to 250 and startOffset to 0, requires the first envelope offset to equal startOffset, and stops when _links.next is null."
    },
    {
      "id": "driver-url",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts",
      "supports": "buildEndpoint appends controls path-style after an ampersand and skips undefined values."
    },
    {
      "id": "testrail-suites",
      "url": "https://support.testrail.com/hc/en-us/articles/7077936624276-Suites",
      "supports": "get_suites/{project_id} takes limit (default and maximum 250) and offset on TestRail 9.3.1 or later and answers with an offset/limit/size/_links envelope around suites; the article states that earlier versions did not accept either and returned a bare array."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth: the top level, query and _mcp are each closed. The endpoint has no filters, so query carries only the page controls. The two call modes are a union, so a page control in all mode or an aggregate bound in page mode is a caller mistake reported before dispatch."
  },
  "outer_result": {
    "driver": "page",
    "tool_data": "array",
    "notes": "Page mode returns the driver's decoded page; the wrapper carries its items as data and describes the rest as pagination metadata. All mode returns the collected array. These fixtures use the envelope TestRail 9.3.1 or later sends; the bare array of earlier versions is decoded as one terminal page."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-query",
      "kind": "invalid",
      "description": "Reject an unsupported query key rather than discarding it; this endpoint has no filters."
    },
    {
      "id": "unknown-control",
      "kind": "invalid",
      "description": "Reject an unknown _mcp control rather than discarding it."
    },
    {
      "id": "page-controls-in-all",
      "kind": "invalid",
      "description": "Reject query.limit or query.offset together with pagination all; page_size and start_offset are the only paging controls of an aggregate."
    },
    {
      "id": "all-controls-in-page",
      "kind": "invalid",
      "description": "Reject an aggregate bound in page mode, where nothing would apply it."
    }
  ],
  "baseline": "page-controls",
