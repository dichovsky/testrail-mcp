      "requiredness": "required",
      "domain": {
        "type": "string",
        "pattern": "^(?!\\.{1,2}$)(?![A-Za-z]:)[^/\\\\\"\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
      },
      "semantics": "The name sent as the attachment part's filename, independent of the file's own name. The driver's CLI source and skill document describe it as the name TestRail stores and shows for the attachment; TestRail's reference does not say how it uses it. A path separator, a drive prefix, a lone . or .., a control byte and a double quote are refused: the name is not a path, and the encoder percent-escapes a quote, so the part would carry a name the caller never asked for.",
      "wire": {
        "location": "multipart",
        "names": [
          "attachment"
        ],
        "encoding": "Sent as the attachment part's filename."
