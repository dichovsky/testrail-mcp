          "description": "Pass the name as the filename argument and send it as the part's filename."
        },
        {
          "id": "valid",
          "kind": "valid",
          "description": "Accept a plain file name and send it even though the file itself is named differently."
        },
        {
          "id": "invalid",
          "kind": "invalid",
          "description": "Reject a name containing a forward or back slash before driver invocation."
        },
        {
          "id": "quote",
