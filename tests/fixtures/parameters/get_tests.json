  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/tests.ts",
      "supports": "getTestsPage and getAllTests validate the run ID and place it as the only path segment. statusId and labelId are validated member by member as identifiers and joined with commas as status_id and label_id, in that order ahead of the paging controls. The envelope collection is named tests."
    },
    {
      "id": "driver-utils",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/utils.ts",
      "supports": "serializeIdFilter validates one identifier or each member of an array with validateId and joins an array with commas; serializeIdList joins a list without validating it and omits an empty one."
    },
    {
      "id": "driver-paginated-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts",
      "supports": "The page helper validates limit and offset before dispatch and appends them after the filters. The all helper copies only pageSize, startOffset, maxPages, maxItems, maxDurationMs and maxBytes from its options."
    },
    {
      "id": "driver-pagination",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts",
      "supports": "collectAllPages validates every bound before the first request, defaults pageSize to 250 and startOffset to 0, requires the first envelope offset to equal startOffset, and stops when _links.next is null."
    },
    {
      "id": "driver-url",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts",
      "supports": "buildEndpoint appends controls path-style after an ampersand, skips undefined values and percent-encodes every key and value independently."
    },
    {
      "id": "testrail-tests",
      "url": "https://support.testrail.com/hc/en-us/articles/7077990441108-Tests",
      "supports": "get_tests/{run_id} returns the tests of a run and takes status_id and label_id as comma-separated ID lists, with limit and offset requiring TestRail 6.7 or later. Its example response is an offset, limit, size and _links envelope around tests."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth. Both filters are arrays because the driver's options for them are arrays, and an empty one is refused rather than dropped."
  },
