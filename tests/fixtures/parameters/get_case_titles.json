  "endpoint": { "family_id": "T02", "http_method": "GET", "route": "get_case_titles", "tool": "testrail_get_case_titles", "driver_method": "cases.getCaseTitles" },
  "sources": [
    { "id": "driver-module", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/cases.ts", "supports": "getCaseTitles refuses an empty list, validates every member as an identifier, joins them with commas as the case_ids query control of get_case_titles, and parses the reply as an array of CaseTitleSchema records. The driver documents the endpoint as TestRail 10.5 or later." },
    { "id": "driver-url", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts", "supports": "buildEndpoint appends the control path-style after an ampersand and percent-encodes the value, so the joining commas are sent as %2C." },
    { "id": "testrail-10-5", "url": "https://support.testrail.com/hc/en-us/articles/50194016906900-TestRail-10-5-1-Default-1001", "supports": "The 10.5.1 release notes introduce get_case_titles as a lightweight call mapping a list of case IDs to their titles. The Cases API reference does not yet document it, so the driver is the source for its request shape." }
  ],
  "input_policy": { "ordinary_fields": "reject", "custom_fields": "reject", "notes": "Strictness is an MCP boundary requirement. The identifier list is the only input and it lives in query, where TestRail reads it." },
  "outer_result": { "driver": "array", "tool_data": "array", "notes": "The driver returns the array of id/title projections as received; entity-field drift is advisory." },
  "requirements": [
    { "id": "unknown-top-level", "kind": "invalid", "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them." },
