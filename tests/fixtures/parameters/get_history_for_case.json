  "endpoint": { "family_id": "T02", "http_method": "GET", "route": "get_history_for_case/{case_id}", "tool": "testrail_get_history_for_case", "driver_method": "cases.getHistoryForCase" },
  "sources": [
    { "id": "driver-module", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/cases.ts", "supports": "getHistoryForCasePage and getAllHistoryForCase validate the case ID and place it as the only path segment; the endpoint takes no filters. The executor is declared with a nested envelope, so TestRail's outer array around one envelope is decoded like the plain envelope, and a bare array as one terminal page." },
    { "id": "driver-paginated-list", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts", "supports": "The page helper validates limit and offset before dispatch and appends them after the filters. The all helper copies only pageSize, startOffset, maxPages, maxItems, maxDurationMs and maxBytes from its options." },
    { "id": "driver-pagination", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts", "supports": "collectAllPages validates every bound before the first request, defaults pageSize to 250 and startOffset to 0, requires the first envelope offset to equal startOffset, and stops when _links.next is null." },
    { "id": "driver-url", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts", "supports": "buildEndpoint appends controls path-style after an ampersand, skips undefined values, repeats an array-valued key once per element and percent-encodes every key and value independently." },
    { "id": "testrail-cases", "url": "https://support.testrail.com/hc/en-us/articles/7077292642580-Cases", "supports": "get_history_for_case/{case_id} requires TestRail 6.5.4 or later, takes limit (250 by default) and offset on TestRail 6.7 or later, and answers with an array wrapping one offset/limit/size/_links envelope around history entries that carry id, type_id, created_on, user_id and a changes array." }
  ],
  "input_policy": { "ordinary_fields": "reject", "custom_fields": "reject", "notes": "Strictness is an MCP boundary requirement at every depth: the top level, query and _mcp are each closed. There are no filters; query carries only the paging controls." },
  "outer_result": { "driver": "page", "tool_data": "array", "notes": "Page mode returns the driver's decoded page; the wrapper carries its entries as data and describes the rest as pagination metadata. All mode returns the collected array. These fixtures use the documented array-wrapped envelope; the driver decodes a plain envelope and a bare array as well." },
