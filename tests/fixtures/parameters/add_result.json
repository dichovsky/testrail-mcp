    "driver_method": "results.addResult"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/results.ts",
      "supports": "addResult validates the test ID, places it as the only path segment of add_result, forwards the JSON payload unchanged and parses the reply advisorily against ResultSchema."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/results.ts",
      "supports": "AddResultPayloadSchema requires status_id and accepts comment, version, elapsed, defects, assignedto_id and a custom_fields record. The bulk payloads wrap an array of the same fields under results, each entry additionally requiring test_id or case_id. EditResultPayloadSchema makes every field optional, declares custom_step_results outright and carries no custom_fields record; its refinement rejects an empty payload. None of these is parsed by the public method, which forwards the payload as given, so every payload rule is enforced at the MCP boundary alone."
    },
    {
      "id": "driver-common",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/common.ts",
      "supports": "zObject uses passthrough, so the declared payload type admits unknown and custom_ properties alike; the MCP boundary must reject ordinary unknown names separately."
    },
    {
      "id": "testrail-results",
      "url": "https://support.testrail.com/hc/en-us/articles/7077819312404-Results",
      "supports": "add_result/{test_id} records a result against one test and takes status_id, comment, version, elapsed, defects and assignedto_id, plus custom fields submitted with their system name prefixed with custom_, of which the step results are one. add_result_for_case/{run_id}/{case_id} takes the same fields while naming the case rather than the test. add_results/{run_id} and add_results_for_cases/{run_id} wrap an array of those entries under results, each naming its test or case, and every referenced test must belong to the named run; TestRail returns the created results in the order they were sent. The documentation states that each entry needs at least one of the status, comment or assignee fields, while the driver's payload requires status_id outright, so a comment-only or assignment-only result cannot be recorded through this client."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "flat_custom_prefix",
    "notes": "Strictness is an MCP boundary requirement at every depth, and here it is the only enforcement: the driver forwards this payload without parsing it. Custom fields are flat custom_ properties with any JSON value, the step results among them; the driver's nested custom_fields container is refused because TestRail does not read it."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail answers with the created result, returned as the driver received it with its flat custom_ properties; entity-field drift is advisory. Recording a result is what changes the test's status, and each call adds to the test's history rather than replacing what is there."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-body",
      "kind": "invalid",
      "description": "Reject an unknown ordinary body field rather than forwarding it; only custom_ names extend a result."
    },
    {
      "id": "custom-fields-container",
      "kind": "invalid",
      "description": "Reject the driver's nested custom_fields object. TestRail reads custom values only as flat custom_ properties, the step results among them, so forwarding the container would drop them silently."
    }
  ],
