    "driver_method": "attachments.getAttachmentsForPlanEntry"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/attachments.ts",
      "supports": "getAttachmentsForPlanEntry validates the plan ID and the entry ID, places them in that order after get_attachments_for_plan_entry, and parses the reply with listOf before unwrapping it. Its comment records that entry_id is the plan entry's GUID from getPlan(...).entries[].id, that TestRail refuses a numeric one with 400 \"Field :entry_id is not a valid test plan entry\", that the reference mislabels it an integer, and that a live instance answered with a bare array."
    },
    {
      "id": "driver-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/list.ts",
      "supports": "listOf accepts a bare array or an envelope whose collection key is present, and unwrapList returns the collection alone: an envelope's offset, limit, size and _links do not survive it. A null collection is an empty list and any other outer shape throws."
    },
    {
      "id": "driver-validation",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/validation.ts",
      "supports": "validateId accepts a positive safe integer; validateEntryId accepts only a UUID, case-insensitively, with nothing before or after it; validatePaginationParams holds limit to 1..250 and offset to a non-negative integer."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/attachments.ts",
      "supports": "AttachmentSchema is one passthrough object for every attachment shape TestRail documents: the upload reply, the legacy case and test entries, the plan, plan-entry and run entries with entity_attachments_id and icon_name, and the 7.1 cloud entries whose id is a UUID string. Every field is nullish and id and entity_id admit a number or a string, so each documented entity parses unchanged."
    },
    {
      "id": "testrail-attachments",
      "url": "https://support.testrail.com/hc/en-us/articles/7077196481428-Attachments",
      "supports": "get_attachments_for_plan_entry/{plan_id}/{entry_id} requires TestRail 6.3 or later, takes the plan ID and the entry ID (both labelled integer), documents no filters and returns the same response format as get_attachments_for_plan, whose example is a bare array. It answers 400 (described there as an invalid test ID) and 403 for no access or insufficient permissions."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement. The endpoint documents no filters and no paging, so the input is the two path identifiers alone."
  },
