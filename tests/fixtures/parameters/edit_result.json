  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/results.ts",
      "supports": "editResult validates the result ID, refuses an empty payload with a validation error before dispatch, places the ID as the only path segment of edit_result, forwards the JSON payload unchanged and parses the reply advisorily against ResultSchema. The driver documents the endpoint as TestRail 10.4 or later."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/results.ts",
      "supports": "AddResultPayloadSchema requires status_id and accepts comment, version, elapsed, defects, assignedto_id and a custom_fields record. The bulk payloads wrap an array of the same fields under results, each entry additionally requiring test_id or case_id. EditResultPayloadSchema makes every field optional, declares custom_step_results outright and carries no custom_fields record; its refinement rejects an empty payload. None of these is parsed by the public method, which forwards the payload as given, so every payload rule is enforced at the MCP boundary alone."
    },
    {
      "id": "driver-common",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/common.ts",
      "supports": "zObject uses passthrough, so the declared payload type admits unknown and custom_ properties alike; the MCP boundary must reject ordinary unknown names separately."
    },
    {
      "id": "testrail-results",
      "url": "https://support.testrail.com/hc/en-us/articles/7077819312404-Results",
      "supports": "The Results reference documents get_results, get_results_for_case, get_results_for_run, add_result, add_result_for_case, add_results and add_results_for_cases, and describes the result fields status_id, comment, version, elapsed, defects and assignedto_id along with custom fields prefixed custom_, of which the step results are one. It does not document edit_result, so this endpoint's request shape rests on the driver."
    },
    {
      "id": "driver-inputs",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/results.ts",
      "supports": "The edit payload's refinement rejecting an empty object is represented at the boundary as a minimum property count, so the emitted JSON Schema states the same rule the driver enforces at runtime."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "flat_custom_prefix",
    "notes": "Strictness is an MCP boundary requirement at every depth. This payload declares the step results outright and carries no custom_fields container, so the flat extension point covers the remaining custom fields. At least one field is required, which the driver enforces at runtime and the emitted schema states as a minimum property count."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail answers with the edited result, returned as the driver received it with its flat custom_ properties; entity-field drift is advisory. This changes a result already recorded rather than adding another, so the test's history is rewritten rather than extended."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
