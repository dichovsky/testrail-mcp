    },
    {
      "id": "unknown-user-field",
      "kind": "invalid",
      "description": "Reject an unknown field inside a user assignment; the response-only global and project role fields are the likely mistakes."
    },
    {
      "id": "users-both-identifiers",
      "kind": "invalid",
      "description": "Reject a user assignment naming the user as both id and user_id, since the two are documented as the same identifier."
    },
    {
      "id": "users-no-identifier",
      "kind": "invalid",
      "description": "Reject a user assignment that names no user at all."
    },
    {
      "id": "body-required",
      "kind": "required",
      "description": "Reject a call with no body rather than sending an empty update."
    }
  ],
