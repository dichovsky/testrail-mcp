  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/projects.ts",
      "supports": "updateProject validates the project ID and forwards the payload unchanged as the JSON body."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/projects.ts",
      "supports": "UpdateProjectPayloadSchema leaves every body field optional. A group assignment takes a positive-integer id and a nonnegative-integer-or-null role_id; a user assignment is an exclusive union naming the user as id or as user_id with the same role_id; default_role_id is a nonnegative integer. Every object permits additional properties."
    },
    {
      "id": "testrail-projects",
      "url": "https://support.testrail.com/hc/en-us/articles/7077792415124-Projects",
      "supports": "update_project supports partial updates and documents name, announcement, show_announcement and suite_mode as request fields. For groups and users, role_id 0 selects the Global Role and null clears the project-specific assignment; project access fields require TestRail 7.3 or later and users require Enterprise."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "The driver's payload schema permits additional properties at every depth; the adapter closes the body, each group assignment and each user assignment. TestRail's own article is inconsistent here (it lists name as required while stating partial updates are supported, and shows is_completed only in responses), so the driver's schema is the contract this manifest reviews."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "Keep the raw project record, including returned users/groups and unknown entity fields. Permission (admin only) and version behaviour (groups need TestRail 7.3 or later, users Enterprise) are upstream responses rather than parameters and are not representable as fixtures here."
  },
  "requirements": [
    {
