  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/tests.ts",
      "supports": "updateTest validates the test ID, places it as the only path segment of update_test, forwards the JSON payload unchanged and parses the reply advisorily against TestSchema. The driver documents this endpoint as updating the labels of a test."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/tests.ts",
      "supports": "UpdateTestLabelsPayloadSchema declares labels as a required array of numbers or strings and carries no other field. The public method forwards the payload without parsing it, so the rule is enforced at the MCP boundary alone."
    },
    {
      "id": "testrail-tests",
      "url": "https://support.testrail.com/hc/en-us/articles/7077990441108-Tests",
      "supports": "update_test/{test_id} updates the labels assigned to an existing test and requires labels, an array of label IDs, titles or both. update_tests assigns the same labels to several tests in one call and does not support a different set per test; its example request and response carry test_ids, although its parameter table names a single test_id, and its response echoes the IDs and labels rather than returning the tests."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth, and here it is the only enforcement: the driver forwards this payload without parsing it. Labels are the one field of a test this endpoint changes; a status comes from adding a result and the remaining fields come from the case."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail answers with the updated test in the get_test format, returned as the driver received it; entity-field drift is advisory."
