  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/suites.ts",
      "supports": "addSuite validates the project ID, places it as the only path segment and sends the payload as the JSON body."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/suites.ts",
      "supports": "AddSuitePayloadSchema requires name and leaves description optional; it permits additional properties."
    },
    {
      "id": "testrail-suites",
      "url": "https://support.testrail.com/hc/en-us/articles/7077936624276-Suites",
      "supports": "add_suite/{project_id} takes name (required) and description in the request body and returns the new suite in the get_suite format."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "The driver's payload schema permits additional properties; the adapter closes it. A field TestRail does not accept is a caller mistake worth reporting rather than forwarding, and this endpoint has no documented custom fields."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "The created suite is returned with its assigned id. Repeating the call creates another suite, which is why the tool is not marked idempotent."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-body-field",
      "kind": "invalid",
      "description": "Reject a body field the driver's schema does not declare, which the driver itself would pass through unchecked."
    },
    {
      "id": "body-required",
      "kind": "required",
      "description": "Reject a call without a body key rather than inventing one; the body must at least name the suite."
    }
  ],
  "baseline": "name-only",
  "parameters": [
    {
      "id": "project_id",
      "input_path": ["project_id"],
      "scope": "path",
      "requiredness": "required",
      "domain_ref": "positive_id",
      "semantics": "No coercion. The validated number is passed positionally and appears verbatim in the path.",
      "driver": { "argument": 0, "path": [] },
      "wire": {
        "location": "path",
        "names": ["project_id"],
        "encoding": "Decimal integer path segment; numeric strings are rejected rather than coerced."
      },
      "sources": ["driver-module", "testrail-suites"]
    },
    {
      "id": "body.name",
      "input_path": ["body", "name"],
      "scope": "body",
      "requiredness": "required",
      "domain": { "type": "string" },
      "semantics": "Sent verbatim. Not trimmed, and an empty string is passed on for TestRail to judge.",
      "driver": { "argument": 1, "path": ["name"] },
      "wire": { "location": "json", "names": ["name"], "encoding": "JSON string in the request body." },
      "sources": ["driver-schema", "testrail-suites"],
      "requirements": [
        { "id": "mapping", "kind": "mapping", "description": "Preserve the value at driver argument 1 under the name key." },
        { "id": "valid", "kind": "valid", "description": "Accept a representative suite name." },
        { "id": "invalid", "kind": "invalid", "description": "Reject a non-string name before driver invocation." },
        { "id": "required", "kind": "required", "description": "Reject a body without a name." }
      ]
    },
    {
      "id": "body.description",
      "input_path": ["body", "description"],
      "scope": "body",
      "requiredness": "optional",
      "domain": { "type": "string" },
      "semantics": "Sent verbatim when supplied. Omitted entirely when absent rather than sent as null.",
      "driver": { "argument": 1, "path": ["description"] },
      "wire": { "location": "json", "names": ["description"], "encoding": "JSON string in the request body." },
      "sources": ["driver-schema", "testrail-suites"],
      "requirements": [
        { "id": "mapping", "kind": "mapping", "description": "Preserve the value at driver argument 1 under the description key." },
        { "id": "valid", "kind": "valid", "description": "Accept a representative description." },
        { "id": "invalid", "kind": "invalid", "description": "Reject a non-string description before driver invocation." },
        { "id": "omitted", "kind": "omitted", "description": "Omit the field entirely when the caller did not supply it." }
      ]
    }
  ],
