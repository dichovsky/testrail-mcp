    "route": "update_shared_step/{shared_step_id}",
    "tool": "testrail_update_shared_step",
    "driver_method": "sharedSteps.updateSharedStep"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/sharedSteps.ts",
      "supports": "updateSharedStep validates the shared-step ID, places it as the only path segment of update_shared_step, forwards the JSON payload unchanged and parses the reply advisorily against SharedStepSchema."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/sharedSteps.ts",
      "supports": "AddSharedStepPayloadSchema requires title and accepts an optional custom_steps_separated array whose entries are open records; UpdateSharedStepPayloadSchema makes both optional, and its documentation records that TestRail accepts an empty object as a no-op. Neither is parsed by the public method, so every payload rule is enforced at the MCP boundary alone."
    },
    {
      "id": "driver-common",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/common.ts",
      "supports": "zObject uses passthrough, so the declared payload type admits unknown and custom_ properties alike; the MCP boundary must reject ordinary unknown names separately."
    },
    {
      "id": "testrail-shared-steps",
      "url": "https://support.testrail.com/hc/en-us/articles/7077919815572-Shared-Steps",
      "supports": "add_shared_step/{project_id} requires title and accepts an optional custom_steps_separated array; each entry should carry at least one of content, additional_info, expected or refs. update_shared_step/{shared_step_id} supports the same fields and replaces every existing step when custom_steps_separated is submitted. Both answer with the set in the get_shared_step format. The separated-steps field carries the default system name, which differs on an instance where the field was removed and recreated. The request-body tables of both methods also repeat the list filters of get_shared_steps, which the driver's payloads do not carry and which TestRail's own examples never send."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "flat_custom_prefix",
    "notes": "Strictness is an MCP boundary requirement at every depth, and here it is the only enforcement: the driver forwards this payload without parsing it. Flat custom_ names are admitted because TestRail's separated-steps field is a custom field whose system name is per-instance."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail answers with the updated set in the get_shared_step format, returned as the driver received it; entity-field drift is advisory. Sending custom_steps_separated replaces every existing step rather than adding to them, so an empty array clears them."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-body",
      "kind": "invalid",
      "description": "Reject an unknown ordinary body field rather than forwarding it; only custom_ names extend the payload."
    },
    {
      "id": "renamed-steps-field",
      "kind": "valid",
      "description": "Accept a flat custom_ field beside the documented one, so an instance whose separated-steps field was recreated under another system name remains usable."
    }
  ],
