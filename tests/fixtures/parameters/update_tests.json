      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/tests.ts",
      "supports": "updateTests validates every member of test_ids as an identifier, posts to update_tests with no path segment, forwards the JSON payload unchanged and parses the reply against UpdateTestsResponseSchema."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/tests.ts",
      "supports": "UpdateTestsLabelsPayloadSchema declares test_ids and labels as required arrays. UpdateTestsResponseSchema records that this endpoint acknowledges the assignment with the IDs and labels rather than returning the tests, and that modelling it as a test list made every successful call resolve to an empty array."
    },
    {
      "id": "testrail-tests",
      "url": "https://support.testrail.com/hc/en-us/articles/7077990441108-Tests",
      "supports": "update_test/{test_id} updates the labels assigned to an existing test and requires labels, an array of label IDs, titles or both. update_tests assigns the same labels to several tests in one call and does not support a different set per test; its example request and response carry test_ids, although its parameter table names a single test_id, and its response echoes the IDs and labels rather than returning the tests."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth. The endpoint takes no path argument, so the body carries everything: the tests to change and the labels to give them."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail acknowledges the assignment by echoing the test IDs and the labels applied; it does not return the tests, so a caller wanting to see one reads it afterwards. One request covers every listed test, whichever runs they belong to."
  },
