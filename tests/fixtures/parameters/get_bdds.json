  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/bdd.ts",
      "supports": "getBddsPage and getAllBdds validate the project ID and place it as the only path segment. suiteId and sectionId are validated as identifiers and sent as suite_id and section_id; labelId goes through serializeIdFilter; a string refs is sent as refs and an array as repeated refs[], which the option's own documentation attributes to TestRail 10.7 and later. The query is built in that fixed order ahead of the paging controls, and the envelope collection is named bdd."
    },
    {
      "id": "driver-utils",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/utils.ts",
      "supports": "serializeIdFilter validates one identifier or each member of an array with validateId, joins an array with commas, and returns undefined for an empty array so the filter would be omitted."
    },
    {
      "id": "driver-paginated-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts",
      "supports": "The page helper validates limit and offset before dispatch and appends them after the filters; an executor declared without request controls sends neither. The all helper copies only pageSize, startOffset, maxPages, maxItems, maxDurationMs and maxBytes from its options."
    },
    {
      "id": "driver-pagination",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts",
      "supports": "collectAllPages validates every bound before the first request, defaults pageSize to 250 and startOffset to 0, requires the first envelope offset to equal startOffset, and stops when _links.next is null."
    },
    {
      "id": "driver-url",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts",
      "supports": "buildEndpoint appends controls path-style after an ampersand, skips undefined values, repeats an array-valued key once per element and percent-encodes every key and value independently."
    },
    {
      "id": "testrail-10-5",
      "url": "https://support.testrail.com/hc/en-us/articles/50194016906900-TestRail-10-5-1-Default-1001",
      "supports": "The 10.5.1 release notes introduce get_bdds as bulk BDD content retrieval returning Gherkin feature content for multiple cases at once, with label, suite, section and refs filtering. The BDD API reference does not document this endpoint, so its request shape rests on the driver."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth: the top level, query and _mcp are each closed. An empty refs or label array is refused rather than dropped, since the driver would omit the filter and widen the result to every BDD case in the project."
  },
  "outer_result": {
    "driver": "page",
    "tool_data": "array",
    "notes": "Page mode returns the driver's decoded page and all mode the collected array. TestRail does not document the row shape of this endpoint and the driver's item schema for it is an open record, so the rows in these examples stand for any object: what is asserted here is the request and the envelope, not the row fields. The open record still requires a row to be an object, so a page of strings or nulls raises an advisory drift warning even though no field is checked."
  },
  "requirements": [
