  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/results.ts",
      "supports": "addResultsForCases validates the run ID, places it as the only path segment of add_results_for_cases, forwards the JSON payload unchanged in one request and parses the reply as an array of results."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/results.ts",
      "supports": "AddResultPayloadSchema requires status_id and accepts comment, version, elapsed, defects, assignedto_id and a custom_fields record. The bulk payloads wrap an array of the same fields under results, each entry additionally requiring test_id or case_id. EditResultPayloadSchema makes every field optional, declares custom_step_results outright and carries no custom_fields record; its refinement rejects an empty payload. None of these is parsed by the public method, which forwards the payload as given, so every payload rule is enforced at the MCP boundary alone."
    },
    {
      "id": "driver-common",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/common.ts",
      "supports": "zObject uses passthrough, so the declared payload type admits unknown and custom_ properties alike; the MCP boundary must reject ordinary unknown names separately."
    },
    {
      "id": "testrail-results",
      "url": "https://support.testrail.com/hc/en-us/articles/7077819312404-Results",
      "supports": "add_result/{test_id} records a result against one test and takes status_id, comment, version, elapsed, defects and assignedto_id, plus custom fields submitted with their system name prefixed with custom_, of which the step results are one. add_result_for_case/{run_id}/{case_id} takes the same fields while naming the case rather than the test. add_results/{run_id} and add_results_for_cases/{run_id} wrap an array of those entries under results, each naming its test or case, and every referenced test must belong to the named run; TestRail returns the created results in the order they were sent. The documentation states that each entry needs at least one of the status, comment or assignee fields, while the driver's payload type declares status_id required, so a comment-only or assignment-only result cannot be recorded through this client; the driver itself parses no payload, so that is a type contract rather than a runtime check."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "flat_custom_prefix",
    "notes": "Strictness is an MCP boundary requirement at every depth, and here it is the only enforcement: the driver forwards this payload without parsing it. Each entry accepts exactly the fields of a single result, with custom values as flat custom_ properties and the driver's nested custom_fields container refused."
  },
  "outer_result": {
    "driver": "array",
    "tool_data": "array",
    "notes": "TestRail answers with the created results in the order the entries were sent, returned as the driver received them; entity-field drift is advisory. Naming the case rather than the test is the only difference from add_results. The adapter neither splits the array nor adds a retry of its own, though the driver's own policy for a rate-limited JSON write resends the same body unchanged. Response validation is advisory here, so a reply that is not the documented array still resolves in the driver and this boundary is what refuses it: the outcome reported is acknowledged rather than unknown, because TestRail accepted the submission and repeating it would record every entry a second time. That differs from the bulk case writes, whose driver method fails closed and never resolves."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-body",
      "kind": "invalid",
      "description": "Reject an unknown ordinary field in the body or in any entry; only custom_ names extend an entry."
    },
    {
      "id": "custom-fields-container",
      "kind": "invalid",
      "description": "Reject the driver's nested custom_fields object in any entry. TestRail reads custom values only as flat custom_ properties, the step results among them."
    },
    {
      "id": "no-split",
      "kind": "mapping",
      "description": "Send exactly one request carrying every entry, in the order given, since TestRail answers in that order. The adapter never splits the array and adds no retry of its own; the driver's documented policy for a rate-limited JSON write still applies and resends the same body unchanged."
    }
  ],
