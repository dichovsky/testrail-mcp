    },
    {
      "id": "config-ids-refused",
      "kind": "invalid",
      "description": "Reject config_ids. A run's combination is fixed when the run is created, and accepting the field would report a change that never happened."
    },
    {
      "id": "name-refused",
      "kind": "invalid",
      "description": "Reject a name, which TestRail derives from the configuration combination."
    }
  ],
