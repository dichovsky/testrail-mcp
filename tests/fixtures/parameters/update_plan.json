  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/plans.ts",
      "supports": "Every write validates its identifiers, an entry identifier through the UUID validator, places them as the path segments of the matching endpoint and forwards the JSON payload unchanged. The replies are parsed advisorily against PlanSchema, PlanEntrySchema or RunSchema."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/plans.ts",
      "supports": "AddPlanPayloadSchema requires name and accepts description, milestone_id, start_on, due_on, refs and an entries array. An entry carries suite_id, name, description, assignedto_id, include_all, case_ids, config_ids, a runs array, dynamic_filters, start_on, due_on and refs; a nested run carries name, description, assignedto_id, include_all, case_ids, config_ids and refs. UpdatePlanPayloadSchema drops entries and makes name optional. AddPlanEntryPayloadSchema matches an entry, and its comments record that suite_id is required only for projects using multiple suites or baselines. UpdatePlanEntryPayloadSchema deliberately omits config_ids and runs, which TestRail does not accept, and suite_id, which the endpoint's request body does not carry. AddRunToPlanEntryPayloadSchema requires config_ids and omits name, which TestRail derives from the configuration; UpdateRunInPlanEntryPayloadSchema omits both. No payload is parsed by the public method, so every payload rule is enforced at the MCP boundary alone."
    },
    {
      "id": "driver-common",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/common.ts",
      "supports": "zObject uses passthrough, so the declared payload types admit unknown properties; the MCP boundary must reject them separately."
    },
    {
      "id": "testrail-plans",
      "url": "https://support.testrail.com/hc/en-us/articles/7077711537684-Plans",
      "supports": "add_plan requires name and accepts description, milestone_id, start_on, due_on and an entries array. add_plan_entry takes suite_id, required for projects with multiple suites or baseline support, plus name, description, assignedto_id, include_all, case_ids, config_ids, refs, start_on, due_on and runs; its top-level config_ids lists the combined configurations for the entry's runs, and every configuration a nested run names must appear in it, each run naming one full combination with one configuration per group. update_plan supports the same fields as add_plan except entries. The reference states that config_ids and runs are not supported on update_plan_entry. add_run_to_plan_entry requires config_ids and takes description, assignedto_id, start_on, due_on, include_all, case_ids and refs."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth, and here it is the only enforcement: the driver forwards this payload without parsing it. entries is absent because TestRail supports every add_plan field here except that one; the entry tools change an entry instead."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail answers with the updated plan in the get_plan format, returned as the driver received it; entity-field drift is advisory."
  },
