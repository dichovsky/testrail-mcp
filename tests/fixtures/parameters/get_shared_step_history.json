  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/sharedSteps.ts",
      "supports": "The history executor is declared without request controls and its prepare step contributes only the path, so neither the page helper nor the aggregate sends a limit or an offset. getSharedStepHistoryPage takes the identifier alone and getAllSharedStepHistory takes it with the safety bounds. The envelope collection is named step_history rather than history."
    },
    {
      "id": "driver-paginated-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts",
      "supports": "The page helper validates limit and offset before dispatch and appends them after the filters; an executor declared without request controls sends neither of them. The all helper copies only pageSize, startOffset, maxPages, maxItems, maxDurationMs and maxBytes from its options."
    },
    {
      "id": "driver-pagination",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts",
      "supports": "collectAllPages validates every bound before the first request, defaults pageSize to 250 and startOffset to 0, requires the first envelope offset to equal startOffset, and stops when _links.next is null."
    },
    {
      "id": "driver-url",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts",
      "supports": "buildEndpoint appends controls path-style after an ampersand and skips undefined values, so an endpoint whose executor sends no controls carries none."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/sharedSteps.ts",
      "supports": "AddSharedStepPayloadSchema requires title and accepts an optional custom_steps_separated array whose entries are open records; the update payload makes both optional. SharedStepSchema requires only id and title, because the list form of the endpoint returns just those two. StepHistoryEntrySchema accepts id and user_id as either an integer or a string, since TestRail Cloud returns integers where the documentation says string."
    },
    {
      "id": "testrail-shared-steps",
      "url": "https://support.testrail.com/hc/en-us/articles/7077919815572-Shared-Steps",
      "supports": "get_shared_step_history/{shared_step_id} requires TestRail 7.3 or later and documents the set's ID as its only parameter. It answers with an offset, limit, size and _links envelope around step_history entries carrying id, user_id, timestamp, title and custom_steps_separated."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth. The endpoint documents no request controls, so this tool offers none: the server chooses each page, and the caller may only bound how much of it the aggregate collects."
  },
  "outer_result": {
    "driver": "page",
    "tool_data": "array",
    "notes": "Page mode returns the server-selected page as the driver decoded it. Because the endpoint takes no controls, a continuation cannot be requested by offset and the wrapper says so; the bounded aggregate is the way to read further. All mode returns the collected array."
  },
