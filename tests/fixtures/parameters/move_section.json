  "endpoint": {
    "family_id": "T01",
    "http_method": "POST",
    "route": "move_section/{section_id}",
    "tool": "testrail_move_section",
    "driver_method": "sections.moveSection"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/sections.ts",
      "supports": "moveSection validates the section ID, sends the payload as the JSON body and resolves with no value whatever TestRail returns. The driver's documentation states that parent_id null moves the section to the root, after_id null moves it to the top of its container, an omitted field leaves that axis unchanged, and that the endpoint returns no body on older TestRail versions and the updated section on newer ones, so it recommends a follow-up getSection for the new position."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/sections.ts",
      "supports": "MoveSectionPayloadSchema makes parent_id and after_id each optional and nullable, and the null-versus-omitted distinction must survive serialization. Values are plain numbers: the driver deliberately imposes no minimum, noting that zero is a useful sentinel in some installs. It permits additional properties."
    },
    {
      "id": "testrail-sections",
      "url": "https://support.testrail.com/hc/en-us/articles/7077918603412-Sections",
      "supports": "move_section/{section_id} requires TestRail 6.5.2 or later. parent_id can be null to move to the root and must be in the same project and suite and not a direct child of the moved section; after_id can be null. The success row says the moved section is returned as part of the response."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "The driver's payload schema permits additional properties; the adapter closes it. A suite_id is the likely mistake, since TestRail only moves within a suite, and is reported rather than forwarded."
  },
  "outer_result": {
    "driver": "void",
    "tool_data": "null",
    "notes": "The driver discards any body TestRail returns and resolves with no value; the wrapper reports data: null. Newer TestRail versions return the moved section, older ones nothing, so a caller that needs the new position reads the section afterwards."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-body-field",
      "kind": "invalid",
      "description": "Reject a body field the driver's schema does not declare, which the driver itself would pass through unchecked."
    },
    {
      "id": "body-required",
      "kind": "required",
      "description": "Reject a call without a body key rather than inventing one. An explicitly empty body is the caller's choice and is sent, changing neither axis."
    }
  ],
  "baseline": "fields-omitted",
  "parameters": [
    {
      "id": "section_id",
      "input_path": ["section_id"],
      "scope": "path",
      "requiredness": "required",
      "domain_ref": "positive_id",
      "semantics": "No coercion. The validated number is passed positionally and appears verbatim in the path.",
      "driver": { "argument": 0, "path": [] },
      "wire": {
        "location": "path",
        "names": ["section_id"],
        "encoding": "Decimal integer path segment; numeric strings are rejected rather than coerced."
      },
      "sources": ["driver-module", "testrail-sections"]
    },
    {
      "id": "body.parent_id",
      "input_path": ["body", "parent_id"],
      "scope": "body",
      "requiredness": "optional",
      "domain": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
      "semantics": "A positive integer moves the section under that parent; null moves it to the root; omission leaves the parent unchanged. Null and omission are distinct on the wire. Zero is accepted because the driver deliberately keeps it as a sentinel some installs use; a fractional, negative or unsafe value can never name a section and is refused. TestRail decides whether the parent exists and is not a child of the moved section.",
      "driver": { "argument": 1, "path": ["parent_id"] },
      "wire": { "location": "json", "names": ["parent_id"], "encoding": "JSON integer or explicit JSON null in the request body; absent when omitted." },
      "sources": ["driver-module", "driver-schema", "testrail-sections"],
      "requirements": [
        { "id": "mapping", "kind": "mapping", "description": "Preserve the value at driver argument 1 under the parent_id key." },
        { "id": "valid", "kind": "valid", "description": "Accept a representative parent section ID." },
        { "id": "null", "kind": "valid", "description": "Send an explicit null to move the section to the root rather than dropping it." },
        { "id": "zero", "kind": "valid", "description": "Forward an explicit zero, the sentinel the driver deliberately keeps." },
        { "id": "invalid", "kind": "invalid", "description": "Reject a numeric string, a fractional, a negative or an unsafe value before driver invocation." },
        { "id": "omitted", "kind": "omitted", "description": "Omit the field entirely when the caller did not supply it, leaving the parent unchanged." }
      ]
    },
    {
      "id": "body.after_id",
      "input_path": ["body", "after_id"],
      "scope": "body",
      "requiredness": "optional",
      "domain": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] },
      "semantics": "A positive integer places the section after that sibling; null places it at the top of its container; omission leaves the position unchanged. Null and omission are distinct on the wire. Zero is accepted for the same reason as on parent_id; a fractional, negative or unsafe value is refused.",
      "driver": { "argument": 1, "path": ["after_id"] },
      "wire": { "location": "json", "names": ["after_id"], "encoding": "JSON integer or explicit JSON null in the request body; absent when omitted." },
      "sources": ["driver-module", "driver-schema", "testrail-sections"],
      "requirements": [
        { "id": "mapping", "kind": "mapping", "description": "Preserve the value at driver argument 1 under the after_id key." },
        { "id": "valid", "kind": "valid", "description": "Accept a representative sibling section ID." },
        { "id": "null", "kind": "valid", "description": "Send an explicit null to move the section to the top rather than dropping it." },
        { "id": "zero", "kind": "valid", "description": "Forward an explicit zero, the sentinel the driver deliberately keeps." },
        { "id": "invalid", "kind": "invalid", "description": "Reject a numeric string, a fractional, a negative or an unsafe value before driver invocation." },
        { "id": "omitted", "kind": "omitted", "description": "Omit the field entirely when the caller did not supply it, leaving the position unchanged." }
      ]
    }
  ],
  "cases": [
