  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/attachments.ts",
      "supports": "deleteAttachment validates the number/UUID union, posts to delete_attachment with the value as the only path segment and no body, under the default retry policy, and discards the parsed reply: it resolves with no value for a successful reply whose body is empty or JSON, and rejects on an error status or a body that is not JSON."
    },
    {
      "id": "driver-validation",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/validation.ts",
      "supports": "validateId accepts any positive integer: it tests Number.isInteger and has no safe-integer bound, so the largest-safe-integer ceiling on these identifiers is this server's own. validateEntryId and validateAttachmentId test strings against one case-insensitive UUID expression anchored at both ends, so a traversal sequence, a surrounding space or a trailing line terminator is refused; validateAttachmentId otherwise accepts any positive integer, with the same missing bound."
    },
    {
      "id": "driver-retry",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/retry-policy.ts",
      "supports": "The default full policy re-sends any request after a 429, and a 5xx or network error only for a GET, so this POST is re-sent after a 429 alone."
    },
    {
      "id": "testrail-attachments",
      "url": "https://support.testrail.com/hc/en-us/articles/7077196481428-Attachments",
      "supports": "delete_attachment/{attachment_id} requires TestRail 5.7 or later, labels attachment_id an integer, answers a successful delete with an empty body and a 200, and answers 400 for an invalid attachment ID and 403 for no access or insufficient permissions."
    },
    {
      "id": "testrail-introduction",
      "url": "https://support.testrail.com/hc/en-us/articles/7077083596436-Introduction-to-the-TestRail-API",
      "supports": "Before TestRail 7.1 an attachment's ID is the number in its link address; from 7.1 on it is the alphanumeric ID shown on the Attachment Details screen."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement. The endpoint takes the identifier alone and no body."
  },
  "outer_result": {
    "driver": "void",
    "tool_data": "null",
    "notes": "The method resolves with no value and the wrapper reports data: null. These fixtures send the documented empty body."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields, a body among them, before driver invocation."
    }
  ],
  "parameters": [
    {
      "id": "attachment_id",
      "input_path": [
        "attachment_id"
      ],
      "scope": "path",
      "requiredness": "required",
      "domain": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}(?![\\s\\S])"
          }
        ]
      },
      "semantics": "The attachment to delete: a positive integer, or a UUID, the format TestRail introduced with release 7.1 (cloud). No coercion: the validated number or string is passed unchanged, and a numeric string is refused rather than read as a number.",
      "driver": {
        "argument": 0,
        "path": []
      },
      "wire": {
        "location": "path",
        "names": [
          "attachment_id"
        ],
        "encoding": "Decimal integer or UUID path segment, sent as given with no trimming or case folding."
      },
      "sources": [
        "driver-module",
        "driver-validation",
        "testrail-attachments",
        "testrail-introduction"
      ],
      "requirements": [
        {
          "id": "mapping",
          "kind": "mapping",
          "description": "Pass the value as the only driver argument and send it as the only path segment."
        },
        {
          "id": "valid",
          "kind": "valid",
          "description": "Accept a positive integer."
        },
        {
          "id": "upper-bound",
          "kind": "valid",
          "description": "Accept the largest safe integer."
        },
        {
          "id": "uuid",
          "kind": "valid",
          "description": "Accept and preserve the UUID union branch."
        },
        {
          "id": "uuid-case",
          "kind": "valid",
          "description": "Accept an upper-case UUID and send it unchanged."
        },
        {
          "id": "invalid",
          "kind": "invalid",
          "description": "Reject a value in neither branch before driver invocation: zero, a fraction, a malformed UUID or a numeric string."
        },
        {
          "id": "above-upper-bound",
          "kind": "invalid",
          "description": "Reject an integer above the largest safe integer, a bound this server adds: the driver's own check has none."
        },
        {
          "id": "path-safety",
          "kind": "invalid",
          "description": "Reject a traversal sequence, which the driver's UUID check also refuses."
        },
        {
          "id": "trailing-line-terminator",
          "kind": "invalid",
          "description": "Reject a UUID with a leading space or a trailing line terminator, LF or CRLF; the whole input must match."
        },
        {
          "id": "required",
          "kind": "required",
          "description": "Reject a missing identifier."
        }
      ]
    }
  ],
