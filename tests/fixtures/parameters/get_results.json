  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/results.ts",
      "supports": "One paginated executor serves all three reads. It validates each path identifier, and builds the query in a fixed order: created_after, created_before and created_by first, then status_id, then defects_filter, ahead of the paging controls. The creation filters are contributed only for get_results_for_run and are dropped for the other two, whichever options are passed. created_by and status_id are validated member by member and joined with commas. The envelope collection is named results."
    },
    {
      "id": "driver-utils",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/utils.ts",
      "supports": "serializeIdList joins a list with commas and omits an empty one."
    },
    {
      "id": "driver-paginated-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts",
      "supports": "The page helper validates limit and offset before dispatch and appends them after the filters. The all helper copies only pageSize, startOffset, maxPages, maxItems, maxDurationMs and maxBytes from its options."
    },
    {
      "id": "driver-pagination",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts",
      "supports": "collectAllPages validates every bound before the first request, defaults pageSize to 250 and startOffset to 0, requires the first envelope offset to equal startOffset, and stops when _links.next is null."
    },
    {
      "id": "driver-url",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts",
      "supports": "buildEndpoint appends controls path-style after an ampersand, skips undefined values and percent-encodes every key and value independently."
    },
    {
      "id": "testrail-results",
      "url": "https://support.testrail.com/hc/en-us/articles/7077819312404-Results",
      "supports": "get_results/{test_id} lists the results of one test and takes defects_filter, status_id as a comma-separated list, and limit and offset on TestRail 6.7 or later; the response is an offset, limit, size and _links envelope around results. The fields, assignedto_id, created_by and updated_by filters require TestRail 10.8 and are outside the pinned driver."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth: the top level, query and _mcp are each closed. Filters the pinned driver does not carry, including those TestRail 10.8 adds, are rejected as unknown query keys rather than dropped."
  },
  "outer_result": {
    "driver": "page",
    "tool_data": "array",
    "notes": "Page mode returns the driver's decoded page and all mode the collected array. Each result carries its custom fields as flat custom_ properties, step results included; entity-field drift is advisory. This endpoint takes no creation filters, which the driver drops for it even when passed."
  },
