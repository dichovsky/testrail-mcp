    "route": "get_dataset/{dataset_id}",
    "tool": "testrail_get_dataset",
    "driver_method": "datasets.getDataset"
  },
  "sources": [
    {
      "id": "driver-module-datasets",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/datasets.ts",
      "supports": "getDataset validates the identifier and places it as the only path segment of get_dataset/{dataset_id}, parsing the reply with DatasetSchema. It sends no query and no body, and issues exactly one request: nothing resolves the variable identifiers the reply carries into a second call."
    },
    {
      "id": "driver-schema-datasets",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/datasets.ts",
      "supports": "DatasetSchema declares id and name as required scalars and variables as a nullish array, so a dataset that omits the key parses. Each entry declares id and name as required scalars and value as nullable, which is how an unset variable is modelled. zObject's passthrough preserves any forward-compatible key the server adds."
    },
    {
      "id": "testrail-datasets",
      "url": "https://support.testrail.com/hc/en-us/articles/7077300491540-Datasets",
      "supports": "get_dataset retrieves one dataset by dataset_id, which the parameter table lists as the only parameter and marks required. The documented response fields are id, name and a variables array whose entries carry the variable's id, its name and the value from this dataset. The documented failures are 400 for an invalid or missing dataset_id, 401 for authentication failure, and 403 for insufficient project permissions or \"Not an Enterprise license/subscription\"."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "One identifier in the path and no request body at all, so every field beside it is refused. Strictness is an MCP boundary requirement; TestRail's own refusals for an unknown dataset, a project the caller cannot access, or an instance without an Enterprise license all arrive from upstream and are reported as they arrive."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail answers with the dataset object and the driver hands it back parsed; entity-field drift is advisory. The reply's variables array is a projection carrying server-assigned identifiers, which is not the name-to-value map the write payloads take."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "single-request",
      "kind": "mapping",
      "description": "Send exactly one request. The identifiers in the reply's variables array are never resolved by a follow-up call."
    },
    {
      "id": "null-value",
      "kind": "valid",
      "description": "Return a variable entry whose value is null rather than refusing the reply or coercing the null away."
    },
    {
      "id": "absent-variables",
      "kind": "valid",
      "description": "Return a dataset that carries no variables key at all rather than inventing an empty array for it."
    }
  ],
  "baseline": "representative-id",
  "parameters": [
