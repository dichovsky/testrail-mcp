      "description": "Reject query paging controls and an _mcp mode: TestRail documents no paging for this endpoint and the driver offers no page or all helper for it."
    },
    {
      "id": "single-request",
      "kind": "mapping",
      "description": "Send exactly one request with no limit or offset."
    },
    {
      "id": "bare-array",
      "kind": "valid",
      "description": "Return a bare-array reply as the list it is."
    }
  ],
