  "sources": [
    {
      "id": "driver-module-milestones",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/milestones.ts",
      "supports": "Every method validates its identifier and places it as the only path segment of the matching endpoint. The list step converts the isCompleted and isStarted booleans to the 1 and 0 TestRail reads and sends neither when they are absent. The reads and the two writes parse against MilestoneSchema; the delete passes no schema and resolves with no value. No payload is parsed by a public method, so every milestone payload rule is enforced at the MCP boundary alone."
    },
    {
      "id": "driver-schema-milestones",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/milestones.ts",
      "supports": "AddMilestonePayloadSchema requires name and accepts description, due_on, start_on, parent_id and refs. UpdateMilestonePayloadSchema makes name optional and adds the is_completed and is_started booleans. parent_id is a plain optional number in both: it admits no null, so detaching a sub-milestone is not reachable through this driver."
    },
    {
      "id": "driver-common",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/common.ts",
      "supports": "zObject uses passthrough, so the declared payload types admit unknown properties; the MCP boundary must reject them separately."
    },
    {
      "id": "testrail-milestones",
      "url": "https://support.testrail.com/hc/en-us/articles/7077723976084-Milestones",
      "supports": "get_milestones takes is_completed and is_started, each 1 or 0, plus limit and offset from TestRail 6.7. add_milestone requires name and accepts description, due_on, start_on, parent_id and refs, with parent_id from TestRail 5.3 and refs from 6.4. update_milestone supports partial updates; its own table lists is_completed, is_started, parent_id and start_on, while the endpoint accepts the add fields too. Deleting a milestone cannot be undone. No field is documented as clearable by null."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "The driver does not parse this payload, so every rule here is the boundary's alone. TestRail's own table calls these request filters while they are sent as a JSON body, which the driver does and this manifest records."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail answers with the created milestone in the get_milestone format, returned as the driver received it; entity-field drift is advisory."
  },
