{
  "schema_version": 1,
  "review": { "status": "complete", "pending": [], "driver_version": "7.2.0", "driver_commit": "cc7751c01c3d3956d061073283bee6b23bf33422", "reviewed_on": "2026-09-19" },
  "endpoint": { "family_id": "T02", "http_method": "GET", "route": "get_cases/{project_id}", "tool": "testrail_get_cases", "driver_method": "cases.getCases" },
  "sources": [
    { "id": "driver-module", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/cases.ts", "supports": "getCasesPage and getAllCases validate the project ID and place it as the only path segment. suiteId and sectionId are validated as identifiers and sent as suite_id and section_id; typeId, priorityId, templateId, milestoneId, createdBy, updatedBy and labelId go through serializeIdFilter; createdAfter, createdBefore, updatedAfter, updatedBefore and filter are forwarded unchanged; a string refs is sent as refs and an array as repeated refs[]. The query is built in that fixed order ahead of the paging controls." },
    { "id": "driver-utils", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/utils.ts", "supports": "serializeIdFilter validates one identifier or each member of an array with validateId, joins an array with commas, and returns undefined for an empty array so the filter would be omitted." },
    { "id": "driver-paginated-list", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts", "supports": "The page helper validates limit and offset before dispatch and appends them after the filters. The all helper copies only pageSize, startOffset, maxPages, maxItems, maxDurationMs and maxBytes from its options." },
    { "id": "driver-pagination", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts", "supports": "collectAllPages validates every bound before the first request, defaults pageSize to 250 and startOffset to 0, requires the first envelope offset to equal startOffset, and stops when _links.next is null." },
    { "id": "driver-url", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts", "supports": "buildEndpoint appends controls path-style after an ampersand, skips undefined values, repeats an array-valued key once per element and percent-encodes every key and value independently." },
    { "id": "testrail-cases", "url": "https://support.testrail.com/hc/en-us/articles/7077292642580-Cases", "supports": "get_cases/{project_id} takes suite_id (optional only in single-suite mode), section_id, created_after, created_before, updated_after and updated_before as UNIX timestamps, created_by, updated_by, milestone_id, priority_id, template_id, type_id and label_id as comma-separated ID lists, filter as a title substring, refs as a reference, and limit (250 by default) and offset on TestRail 6.7 or later; it answers with an offset/limit/size/_links envelope around cases. The fields, status_id and assignedto_id filters require TestRail 10.8 and are outside the pinned driver." }
  ],
  "input_policy": { "ordinary_fields": "reject", "custom_fields": "reject", "notes": "Strictness is an MCP boundary requirement at every depth: the top level, query and _mcp are each closed. Filters the pinned driver does not carry (fields, status_id, assignedto_id of TestRail 10.8) are rejected as unknown query keys rather than dropped. Whether suite_id may be omitted depends on the project's suite mode, which only TestRail knows, so the adapter leaves it optional and reports TestRail's answer." },
  "outer_result": { "driver": "page", "tool_data": "array", "notes": "Page mode returns the driver's decoded page; the wrapper carries its items as data and describes the rest as pagination metadata. All mode returns the collected array. Cases carry their custom fields as flat custom_* properties. These fixtures use the envelope TestRail 6.7 or later sends; a bare array is decoded as one terminal page." },
  "requirements": [
    { "id": "unknown-top-level", "kind": "invalid", "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them." },
    { "id": "unknown-query", "kind": "invalid", "description": "Reject an unsupported query key rather than discarding it." },
    { "id": "unknown-control", "kind": "invalid", "description": "Reject an unknown _mcp control rather than discarding it." },
    { "id": "page-controls-in-all", "kind": "invalid", "description": "Reject query.limit or query.offset together with pagination all; page_size and start_offset are the only paging controls of an aggregate." },
    { "id": "all-controls-in-page", "kind": "invalid", "description": "Reject an aggregate bound in page mode, where nothing would apply it." }
  ],
  "baseline": "page-controls",
  "parameters": [
    { "id": "project_id", "input_path": ["project_id"], "scope": "path", "requiredness": "required", "domain_ref": "positive_id", "semantics": "No coercion. The validated number is passed positionally to either helper and appears verbatim in the path of every request.", "driver": { "argument": 0, "path": [] }, "wire": { "location": "path", "names": ["project_id"], "encoding": "Decimal integer path segment; numeric strings are rejected rather than coerced." }, "sources": ["driver-module", "testrail-cases"] },
    { "id": "query.suite_id", "input_path": ["query", "suite_id"], "scope": "query", "requiredness": "optional", "domain_ref": "positive_id", "semantics": "The suite to list. Passed to either helper as suiteId and sent as the suite_id control on every request; omitted entirely when absent, which TestRail accepts only for single-suite projects.", "driver": { "argument": 1, "path": ["suiteId"] }, "wire": { "location": "query", "names": ["suite_id"], "encoding": "Decimal integer appended path-style first among the filters." }, "sources": ["driver-module", "testrail-cases"] },
    { "id": "query.section_id", "input_path": ["query", "section_id"], "scope": "query", "requiredness": "optional", "domain_ref": "positive_id", "semantics": "The section to list. Passed to either helper as sectionId and sent as the section_id control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["sectionId"] }, "wire": { "location": "query", "names": ["section_id"], "encoding": "Decimal integer appended path-style after suite_id." }, "sources": ["driver-module", "testrail-cases"] },
    { "id": "query.type_id", "input_path": ["query", "type_id"], "scope": "query", "requiredness": "optional", "domain_ref": "id_filter", "semantics": "Case types to match. Passed to either helper as typeId and sent comma-joined as the type_id control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["typeId"] }, "wire": { "location": "query", "names": ["type_id"], "encoding": "Decimal integers joined by commas, percent-encoded as %2C, appended path-style before the paging controls." }, "sources": ["driver-module", "driver-utils", "driver-url", "testrail-cases"] },
    { "id": "query.priority_id", "input_path": ["query", "priority_id"], "scope": "query", "requiredness": "optional", "domain_ref": "id_filter", "semantics": "Priorities to match. Passed to either helper as priorityId and sent comma-joined as the priority_id control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["priorityId"] }, "wire": { "location": "query", "names": ["priority_id"], "encoding": "Decimal integers joined by commas, percent-encoded as %2C, appended path-style before the paging controls." }, "sources": ["driver-module", "driver-utils", "driver-url", "testrail-cases"] },
    { "id": "query.template_id", "input_path": ["query", "template_id"], "scope": "query", "requiredness": "optional", "domain_ref": "id_filter", "semantics": "Templates to match (TestRail 5.2 or later). Passed to either helper as templateId and sent comma-joined as the template_id control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["templateId"] }, "wire": { "location": "query", "names": ["template_id"], "encoding": "Decimal integers joined by commas, percent-encoded as %2C, appended path-style before the paging controls." }, "sources": ["driver-module", "driver-utils", "driver-url", "testrail-cases"] },
    { "id": "query.milestone_id", "input_path": ["query", "milestone_id"], "scope": "query", "requiredness": "optional", "domain_ref": "id_filter", "semantics": "Milestones to match; unavailable when the milestone field is disabled for the project. Passed to either helper as milestoneId and sent comma-joined as the milestone_id control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["milestoneId"] }, "wire": { "location": "query", "names": ["milestone_id"], "encoding": "Decimal integers joined by commas, percent-encoded as %2C, appended path-style before the paging controls." }, "sources": ["driver-module", "driver-utils", "driver-url", "testrail-cases"] },
    { "id": "query.created_after", "input_path": ["query", "created_after"], "scope": "query", "requiredness": "optional", "domain_ref": "unix_timestamp", "semantics": "Only cases created after this time. Passed to either helper as createdAfter and sent unchanged as the created_after control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["createdAfter"] }, "wire": { "location": "query", "names": ["created_after"], "encoding": "Decimal integer appended path-style before the paging controls." }, "sources": ["driver-module", "testrail-cases"] },
    { "id": "query.created_before", "input_path": ["query", "created_before"], "scope": "query", "requiredness": "optional", "domain_ref": "unix_timestamp", "semantics": "Only cases created before this time. Passed to either helper as createdBefore and sent unchanged as the created_before control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["createdBefore"] }, "wire": { "location": "query", "names": ["created_before"], "encoding": "Decimal integer appended path-style before the paging controls." }, "sources": ["driver-module", "testrail-cases"] },
    { "id": "query.created_by", "input_path": ["query", "created_by"], "scope": "query", "requiredness": "optional", "domain_ref": "id_filter", "semantics": "Creators to match, as user IDs. Passed to either helper as createdBy and sent comma-joined as the created_by control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["createdBy"] }, "wire": { "location": "query", "names": ["created_by"], "encoding": "Decimal integers joined by commas, percent-encoded as %2C, appended path-style before the paging controls." }, "sources": ["driver-module", "driver-utils", "driver-url", "testrail-cases"] },
    { "id": "query.filter", "input_path": ["query", "filter"], "scope": "query", "requiredness": "optional", "domain": { "type": "string" }, "semantics": "A substring the case title must contain. Passed to either helper as filter and sent percent-encoded as the filter control; omitted entirely when absent.", "driver": { "argument": 1, "path": ["filter"] }, "wire": { "location": "query", "names": ["filter"], "encoding": "Percent-encoded string appended path-style after created_by." }, "sources": ["driver-module", "driver-url", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve the string as the filter option and control." }, { "id": "valid", "kind": "valid", "description": "Accept a string, including characters that must be percent-encoded." }, { "id": "invalid", "kind": "invalid", "description": "Reject a number in place of the string before driver invocation." }, { "id": "omitted", "kind": "omitted", "description": "Send no filter control when the caller did not supply one." } ] },
    { "id": "query.updated_after", "input_path": ["query", "updated_after"], "scope": "query", "requiredness": "optional", "domain_ref": "unix_timestamp", "semantics": "Only cases updated after this time. Passed to either helper as updatedAfter and sent unchanged as the updated_after control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["updatedAfter"] }, "wire": { "location": "query", "names": ["updated_after"], "encoding": "Decimal integer appended path-style before the paging controls." }, "sources": ["driver-module", "testrail-cases"] },
    { "id": "query.updated_before", "input_path": ["query", "updated_before"], "scope": "query", "requiredness": "optional", "domain_ref": "unix_timestamp", "semantics": "Only cases updated before this time. Passed to either helper as updatedBefore and sent unchanged as the updated_before control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["updatedBefore"] }, "wire": { "location": "query", "names": ["updated_before"], "encoding": "Decimal integer appended path-style before the paging controls." }, "sources": ["driver-module", "testrail-cases"] },
    { "id": "query.updated_by", "input_path": ["query", "updated_by"], "scope": "query", "requiredness": "optional", "domain_ref": "id_filter", "semantics": "Last updaters to match, as user IDs. Passed to either helper as updatedBy and sent comma-joined as the updated_by control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["updatedBy"] }, "wire": { "location": "query", "names": ["updated_by"], "encoding": "Decimal integers joined by commas, percent-encoded as %2C, appended path-style before the paging controls." }, "sources": ["driver-module", "driver-utils", "driver-url", "testrail-cases"] },
    { "id": "query.label_id", "input_path": ["query", "label_id"], "scope": "query", "requiredness": "optional", "domain_ref": "id_filter", "semantics": "Labels to match (TestRail 10.5 or later). Passed to either helper as labelId and sent comma-joined as the label_id control on every request; omitted entirely when absent.", "driver": { "argument": 1, "path": ["labelId"] }, "wire": { "location": "query", "names": ["label_id"], "encoding": "Decimal integers joined by commas, percent-encoded as %2C, appended path-style before the paging controls." }, "sources": ["driver-module", "driver-utils", "driver-url", "testrail-cases"] },
    { "id": "query.refs", "input_path": ["query", "refs"], "scope": "query", "requiredness": "optional", "domain": { "anyOf": [ { "type": "string" }, { "type": "array", "minItems": 1, "items": { "type": "string" } } ] }, "semantics": "References to match (TestRail 6.5.2 or later). A string is sent as the single refs control; a non-empty array is sent as one repeated refs[] control per element, the form TestRail 10.7 accepts. An empty array is refused rather than letting the driver drop the filter.", "driver": { "argument": 1, "path": ["refs"] }, "wire": { "location": "query", "names": ["refs", "refs[]"], "encoding": "String -> refs=<percent-encoded string>; array -> one refs%5B%5D=<encoded value> per element, appended path-style last among the filters." }, "sources": ["driver-module", "driver-url", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve the value as the refs option and control." }, { "id": "valid", "kind": "valid", "description": "Accept a single reference string, including characters that must be percent-encoded." }, { "id": "array", "kind": "valid", "description": "Preserve every array element as a repeated refs[] control, each encoded independently." }, { "id": "invalid", "kind": "invalid", "description": "Reject a non-string member before driver invocation." }, { "id": "empty-array", "kind": "invalid", "description": "Reject an empty array rather than sending no refs control for it." }, { "id": "omitted", "kind": "omitted", "description": "Send no refs control when the caller did not supply one." } ] },
    { "id": "query.limit", "input_path": ["query", "limit"], "scope": "query", "requiredness": "optional", "domain_ref": "pagination_limit", "semantics": "Page mode only. Sent explicitly on every page request: the caller's value, or 50 when omitted.", "driver": { "argument": 1, "path": ["limit"] }, "wire": { "location": "query", "names": ["limit"], "encoding": "Decimal integer appended path-style after the filters." }, "sources": ["driver-paginated-list", "driver-url", "testrail-cases"] },
    { "id": "query.offset", "input_path": ["query", "offset"], "scope": "query", "requiredness": "optional", "domain_ref": "pagination_offset", "semantics": "Page mode only. Sent explicitly on every page request: the caller's value, or 0 when omitted.", "driver": { "argument": 1, "path": ["offset"] }, "wire": { "location": "query", "names": ["offset"], "encoding": "Decimal integer appended path-style after limit." }, "sources": ["driver-paginated-list", "driver-url", "testrail-cases"] },
    { "id": "_mcp.pagination", "input_path": ["_mcp", "pagination"], "scope": "mcp", "requiredness": "optional", "domain": { "enum": ["page", "all"] }, "semantics": "Selects the public page helper or the bounded all helper. Never passed to the driver.", "driver": null, "wire": { "location": "adapter_only", "names": [], "encoding": "Never serialized upstream." }, "sources": ["driver-module"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Select the page helper for page and the all helper for all." }, { "id": "page", "kind": "valid", "description": "Accept an explicit page mode." }, { "id": "all", "kind": "valid", "description": "Accept all mode." }, { "id": "invalid", "kind": "invalid", "description": "Reject an unknown mode before driver invocation." }, { "id": "omitted", "kind": "omitted", "description": "Use page mode when omitted." } ] },
    { "id": "_mcp.page_size", "input_path": ["_mcp", "page_size"], "scope": "mcp", "requiredness": "optional", "domain_ref": "aggregate_page_size", "baseline": "all-defaults", "semantics": "All mode only. Forwarded as the driver's pageSize when supplied; the driver's own default of 250 applies when omitted.", "driver": { "argument": 1, "path": ["pageSize"] }, "wire": { "location": "query", "names": ["limit"], "encoding": "Sent as the limit control of every request the aggregate issues." }, "sources": ["driver-paginated-list", "driver-pagination"] },
    { "id": "_mcp.start_offset", "input_path": ["_mcp", "start_offset"], "scope": "mcp", "requiredness": "optional", "domain_ref": "aggregate_start_offset", "baseline": "all-defaults", "semantics": "All mode only. Forwarded as the driver's startOffset when supplied; the aggregate starts at 0 when omitted.", "driver": { "argument": 1, "path": ["startOffset"] }, "wire": { "location": "query", "names": ["offset"], "encoding": "Sent as the offset of the first request; later offsets follow the continuation links." }, "sources": ["driver-paginated-list", "driver-pagination"] },
    { "id": "_mcp.max_items", "input_path": ["_mcp", "max_items"], "scope": "mcp", "requiredness": "optional", "domain_ref": "aggregate_max_items", "baseline": "all-defaults", "semantics": "All mode only. Forwarded verbatim when supplied; the configured limit is forwarded when omitted.", "driver": { "argument": 1, "path": ["maxItems"] }, "wire": { "location": "adapter_only", "names": [], "encoding": "Never serialized; bounds the collection inside the driver." }, "sources": ["driver-pagination"] },
    { "id": "_mcp.max_pages", "input_path": ["_mcp", "max_pages"], "scope": "mcp", "requiredness": "optional", "domain_ref": "aggregate_max_pages", "baseline": "all-defaults", "semantics": "All mode only. Forwarded verbatim when supplied; the configured limit is forwarded when omitted.", "driver": { "argument": 1, "path": ["maxPages"] }, "wire": { "location": "adapter_only", "names": [], "encoding": "Never serialized; bounds the collection inside the driver." }, "sources": ["driver-pagination"] },
    { "id": "_mcp.max_bytes", "input_path": ["_mcp", "max_bytes"], "scope": "mcp", "requiredness": "optional", "domain_ref": "aggregate_max_bytes", "baseline": "all-defaults", "semantics": "All mode only. Forwarded verbatim when supplied; the configured limit is forwarded when omitted.", "driver": { "argument": 1, "path": ["maxBytes"] }, "wire": { "location": "adapter_only", "names": [], "encoding": "Never serialized; bounds the serialized item bytes inside the driver." }, "sources": ["driver-pagination"] },
    { "id": "_mcp.max_duration_ms", "input_path": ["_mcp", "max_duration_ms"], "scope": "mcp", "requiredness": "optional", "domain_ref": "aggregate_max_duration_ms", "baseline": "all-defaults", "semantics": "All mode only. Forwarded verbatim when supplied; the configured limit is forwarded when omitted.", "driver": { "argument": 1, "path": ["maxDurationMs"] }, "wire": { "location": "adapter_only", "names": [], "encoding": "Never serialized; bounds the aggregate's wall-clock time inside the driver." }, "sources": ["driver-pagination"] }
