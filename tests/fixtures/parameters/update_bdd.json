  "endpoint": {
    "family_id": "T03",
    "http_method": "POST",
    "route": "update_bdd/{case_id}",
    "tool": "testrail_update_bdd",
    "driver_method": "bdd.updateBdd"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/bdd.ts",
      "supports": "updateBdd validates the case ID, places it as the only path segment of update_bdd and posts the file through the same multipart pipeline as addBdd with the caller's filename, parsing TestRail's reply as a case."
    },
    {
      "id": "driver-client",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/client-core.ts",
      "supports": "The multipart pipeline appends the file to a FormData under the field name attachment with the caller's filename, and opens the staged path as a blob whose media type is the one supplied or empty when none was. That form data is the request body, and a multipart upload is declared never to retry because the body is a consumed stream."
    },
    {
      "id": "testrail-bdd",
      "url": "https://support.testrail.com/hc/en-us/articles/7832161593620-BDDs",
      "supports": "The BDD reference documents get_bdd and add_bdd only; it does not document update_bdd. This endpoint's request shape therefore rests on the driver, which sends it exactly as add_bdd but against a case rather than a section."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement. The transport stages an owned copy of the caller's file inside the configured upload roots before dispatch and hands the driver that copy, so the bytes sent are the bytes approved; the staging, its containment and its disposal belong to the transport rather than to this endpoint."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail answers with the case, returned as the driver received it with its flat custom_* properties; entity-field drift is advisory. Uploading replaces the case's previous scenario outright rather than adding to it."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "feature-extension",
      "kind": "invalid",
      "description": "Reject a filename that does not end in .feature, which TestRail would not read as a feature file."
    },
    {
      "id": "single-request",
      "kind": "mapping",
      "description": "Send exactly one multipart request. The adapter never re-reads the file or repeats the upload."
    }
  ],
  "baseline": "feature-upload",
  "files": [
    {
      "token": "login-feature",
      "filename": "login.feature",
      "utf8": "@APP-1\nFeature: Users cannot login with invalid credentials\n\n  Scenario: User cannot login with invalid password\n    Given I have entered \"invalid\" into the password field\n    When I click the login button\n    Then I see I am not logged in\n"
    }
  ],
  "parameters": [
    {
      "id": "case_id",
      "input_path": [
        "case_id"
      ],
      "scope": "path",
      "requiredness": "required",
      "domain_ref": "positive_id",
      "semantics": "No coercion. The validated number is passed positionally and appears verbatim as the only path segment.",
      "driver": {
        "argument": 0,
        "path": []
      },
      "wire": {
        "location": "path",
        "names": [
          "case_id"
        ],
        "encoding": "Decimal integer path segment; numeric strings are rejected rather than coerced."
      },
      "sources": [
        "driver-module",
        "testrail-bdd"
      ]
    },
    {
      "id": "file_path",
      "input_path": [
        "file_path"
      ],
      "scope": "file",
      "requiredness": "required",
      "domain": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
      },
      "semantics": "The caller's path to a Gherkin feature file. The transport stages an owned copy within the configured upload roots and the driver receives that copy's path, so this value never reaches TestRail; the file's contents do.",
      "driver": {
        "argument": 1,
        "path": [
          "path"
        ]
      },
      "wire": {
        "location": "multipart",
        "names": [
          "attachment"
        ],
        "encoding": "The file's contents become the attachment part's body."
      },
      "sources": [
        "driver-module",
        "driver-client"
      ],
      "requirements": [
        {
          "id": "mapping",
          "kind": "mapping",
          "description": "Pass the staged copy's path as the file argument."
        },
        {
          "id": "valid",
          "kind": "valid",
          "description": "Accept a path and upload that file's contents."
        },
        {
          "id": "invalid",
          "kind": "invalid",
          "description": "Reject a path carrying a control character before driver invocation."
        },
        {
          "id": "required",
          "kind": "required",
          "description": "Reject a missing path."
        }
      ]
    },
    {
      "id": "filename",
      "input_path": [
        "filename"
      ],
      "scope": "file",
      "requiredness": "required",
      "domain": {
        "type": "string",
        "pattern": "^[^/\\\\\"]+\\.feature(?![\\s\\S])"
      },
      "semantics": "The name TestRail records for the uploaded file. It must end in .feature. Path separators, control bytes and a double quote are refused: the encoder escapes a quote, so TestRail would record a name the caller never asked for.",
      "driver": {
        "argument": 2,
        "path": []
      },
      "wire": {
        "location": "multipart",
        "names": [
          "attachment"
        ],
        "encoding": "Sent as the attachment part's filename."
      },
      "sources": [
        "driver-module",
        "driver-client",
        "testrail-bdd"
      ],
      "requirements": [
        {
          "id": "mapping",
          "kind": "mapping",
          "description": "Pass the name as the third driver argument and send it as the part's filename."
        },
        {
          "id": "valid",
          "kind": "valid",
          "description": "Accept a .feature name."
        },
        {
          "id": "invalid",
          "kind": "invalid",
          "description": "Reject a name containing a path separator before driver invocation."
        },
        {
          "id": "required",
          "kind": "required",
          "description": "Reject a missing name."
        },
        {
          "id": "quote",
          "kind": "invalid",
          "description": "Reject a name containing a double quote, which the multipart encoder percent-escapes, so the recorded name would differ from the one requested."
        }
      ]
    },
    {
      "id": "content_type",
      "input_path": [
        "content_type"
      ],
      "scope": "file",
      "requiredness": "optional",
      "domain": {
        "type": "string",
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+/[!#$%&'*+.^_`|~0-9A-Za-z-]+(?: *; *[!#$%&'*+.^_`|~0-9A-Za-z-]+ *= *(?:[!#$%&'*+.^_`|~0-9A-Za-z-]+|\"[^\"]*\"))*(?![\\s\\S])"
      },
      "semantics": "The media type recorded for the part, as a type and subtype with optional parameters. Omitting it leaves the part's type undeclared, which the encoder writes as application/octet-stream and leaves the reading of the file to TestRail; a supplied value becomes the staged copy's type.",
      "driver": {
        "argument": 1,
        "path": [
          "type"
        ]
      },
      "wire": {
        "location": "multipart",
        "names": [
          "attachment"
        ],
        "encoding": "Sent as the attachment part's content type. With none supplied the part carries application/octet-stream, which is what the encoder writes for a blob with no declared type."
      },
      "sources": [
        "driver-client"
      ],
      "requirements": [
        {
          "id": "mapping",
          "kind": "mapping",
          "description": "Pass the value as the staged file's type."
        },
        {
          "id": "valid",
          "kind": "valid",
          "description": "Accept a media type and send it on the part."
        },
        {
          "id": "invalid",
          "kind": "invalid",
          "description": "Reject a value that is not a media type before driver invocation."
        },
        {
          "id": "omitted",
          "kind": "omitted",
          "description": "Declare no type on the staged copy when the caller supplied none, leaving the encoder's application/octet-stream on the part."
        }
      ]
    }
  ],
