  "endpoint": {
    "family_id": "T01",
    "http_method": "POST",
    "route": "add_section/{project_id}",
    "tool": "testrail_add_section",
    "driver_method": "sections.addSection"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/sections.ts",
      "supports": "addSection validates the project ID, places it as the only path segment and sends the payload as the JSON body."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/sections.ts",
      "supports": "AddSectionPayloadSchema requires name and leaves suite_id, parent_id and description optional; suite_id and parent_id are plain numbers in the driver, which leaves the suite-mode rule to TestRail. It permits additional properties."
    },
    {
      "id": "testrail-sections",
      "url": "https://support.testrail.com/hc/en-us/articles/7077918603412-Sections",
      "supports": "add_section/{project_id} takes name (required), suite_id (required unless the project is in single-suite mode, ignored there), parent_id and description, and returns the new section in the get_section format."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "The driver's payload schema permits additional properties; the adapter closes it. Whether suite_id is required depends on the project's suite mode, which only TestRail knows at request time, so the adapter leaves it optional and reports TestRail's 400 rather than guessing."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "The created section is returned with its assigned id, depth and display_order. Repeating the call creates another section, which is why the tool is not marked idempotent."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-body-field",
      "kind": "invalid",
      "description": "Reject a body field the driver's schema does not declare, which the driver itself would pass through unchecked; the response-only hierarchy fields are the likely mistakes."
    },
    {
      "id": "body-required",
      "kind": "required",
      "description": "Reject a call without a body key rather than inventing one; the body must at least name the section."
    }
  ],
  "baseline": "name-only",
  "parameters": [
    {
      "id": "project_id",
      "input_path": ["project_id"],
      "scope": "path",
      "requiredness": "required",
      "domain_ref": "positive_id",
      "semantics": "No coercion. The validated number is passed positionally and appears verbatim in the path.",
      "driver": { "argument": 0, "path": [] },
      "wire": {
        "location": "path",
        "names": ["project_id"],
        "encoding": "Decimal integer path segment; numeric strings are rejected rather than coerced."
      },
      "sources": ["driver-module", "testrail-sections"]
    },
    {
      "id": "body.name",
      "input_path": ["body", "name"],
      "scope": "body",
      "requiredness": "required",
      "domain": { "type": "string" },
      "semantics": "Sent verbatim. Not trimmed, and an empty string is passed on for TestRail to judge.",
      "driver": { "argument": 1, "path": ["name"] },
      "wire": { "location": "json", "names": ["name"], "encoding": "JSON string in the request body." },
      "sources": ["driver-schema", "testrail-sections"],
      "requirements": [
        { "id": "mapping", "kind": "mapping", "description": "Preserve the value at driver argument 1 under the name key." },
        { "id": "valid", "kind": "valid", "description": "Accept a representative section name." },
        { "id": "invalid", "kind": "invalid", "description": "Reject a non-string name before driver invocation." },
        { "id": "required", "kind": "required", "description": "Reject a body without a name." }
      ]
    },
    {
      "id": "body.suite_id",
      "input_path": ["body", "suite_id"],
      "scope": "body",
      "requiredness": "optional",
      "domain_ref": "positive_id",
      "semantics": "The suite to create the section in. The driver forwards any number; the adapter holds body identifiers to the same domain as path identifiers, since a fractional, non-positive or unsafe value can never name an existing suite. Whether the field is required for this project's suite mode is TestRail's to decide. Omitted entirely when absent.",
      "driver": { "argument": 1, "path": ["suite_id"] },
      "wire": { "location": "json", "names": ["suite_id"], "encoding": "JSON integer in the request body." },
      "sources": ["driver-schema", "testrail-sections"]
    },
    {
      "id": "body.parent_id",
      "input_path": ["body", "parent_id"],
      "scope": "body",
      "requiredness": "optional",
      "domain_ref": "positive_id",
      "semantics": "The parent section under which the new section is created; TestRail decides whether it exists. Held to the identifier domain for the same reason as suite_id. Omitted entirely when absent, which creates a root section.",
      "driver": { "argument": 1, "path": ["parent_id"] },
      "wire": { "location": "json", "names": ["parent_id"], "encoding": "JSON integer in the request body." },
      "sources": ["driver-schema", "testrail-sections"]
    },
    {
      "id": "body.description",
      "input_path": ["body", "description"],
      "scope": "body",
      "requiredness": "optional",
      "domain": { "type": "string" },
      "semantics": "Sent verbatim when supplied. Omitted entirely when absent rather than sent as null.",
      "driver": { "argument": 1, "path": ["description"] },
      "wire": { "location": "json", "names": ["description"], "encoding": "JSON string in the request body." },
      "sources": ["driver-schema", "testrail-sections"],
      "requirements": [
        { "id": "mapping", "kind": "mapping", "description": "Preserve the value at driver argument 1 under the description key." },
        { "id": "valid", "kind": "valid", "description": "Accept a representative description." },
        { "id": "invalid", "kind": "invalid", "description": "Reject a non-string description before driver invocation." },
        { "id": "omitted", "kind": "omitted", "description": "Omit the field entirely when the caller did not supply it." }
      ]
    }
  ],
  "cases": [
