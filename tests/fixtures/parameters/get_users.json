      "description": "Return the users as an array when TestRail answers with a bare array."
    },
    {
      "id": "wrapped",
      "kind": "mapping",
      "description": "Return the same array when TestRail answers with a users wrapper."
    },
    {
      "id": "null-collection",
      "kind": "mapping",
      "description": "Return an empty array, not an error, when TestRail answers with a null users collection."
    }
  ],
  "baseline": "every-user",
  "parameters": [
    {
      "id": "query.project_id",
      "input_path": [
        "query",
        "project_id"
      ],
      "scope": "query",
      "requiredness": "optional",
      "domain_ref": "positive_id",
      "semantics": "The project to scope the list to. Omitted, the call reads every user and needs administrator access; supplied, it reads the users with explicit access to that project, which TestRail requires of non-administrators from 6.6 and which also omits inactive users, omits users holding only global access, and reports each role at its project level. The driver validates it before dispatch, so a non-positive value is the driver's refusal rather than the boundary's alone.",
      "driver": {
        "argument": 0,
        "path": []
      },
      "wire": {
        "location": "path",
        "names": [
          "project_id"
        ],
        "encoding": "Appended as a path segment, get_users/{project_id}; omitted entirely when the caller sends none, which is a different endpoint rather than the same one with a blank value."
      },
      "sources": [
        "driver-module-users",
        "testrail-users"
      ]
    }
  ],
