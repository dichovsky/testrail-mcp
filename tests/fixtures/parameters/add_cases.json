{
  "schema_version": 1,
  "review": { "status": "complete", "pending": [], "driver_version": "7.2.0", "driver_commit": "cc7751c01c3d3956d061073283bee6b23bf33422", "reviewed_on": "2026-09-19" },
  "endpoint": { "family_id": "T02", "http_method": "POST", "route": "add_cases/{section_id}", "tool": "testrail_add_cases", "driver_method": "cases.addCases" },
  "sources": [
    { "id": "driver-module", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/cases.ts", "supports": "addCases validates the section ID, sends it as the only path segment of add_cases, wraps the array as { cases: [...] } in one JSON request (a bare array is rejected by TestRail, confirmed by the driver's live probe), unwraps TestRail's { cases: [...] } reply, and fails closed with a status-200 API error when a successful reply has any other shape, because the write may already have happened. AddCasesBulkPayloadSchema requires at least one item." },
    { "id": "driver-schema", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/cases.ts", "supports": "The case payload schemas declare title, template_id, type_id, priority_id, estimate, milestone_id, refs, labels (numbers or strings), is_legacy and a legacy custom_fields record; update payloads add section_id and the bulk update requires case_ids. Every identifier is a plain number in the driver." },
    { "id": "driver-common", "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/common.ts", "supports": "zObject uses passthrough, so the driver forwards unknown and custom_* properties alike; the MCP boundary must reject ordinary unknown names separately." },
    { "id": "testrail-cases", "url": "https://support.testrail.com/hc/en-us/articles/7077292642580-Cases", "supports": "add_case and update_case take title, template_id, type_id, priority_id, estimate (a timespan such as 30s or 1m 45s), milestone_id, refs (a comma-separated string), labels (an array of IDs or titles) and is_legacy, plus custom fields submitted with their system name prefixed with custom_. update_case supports partial updates and section_id requires TestRail 6.5.2 or later. update_cases applies the same values to every case in case_ids and add_cases takes an array of case objects." }
  ],
  "input_policy": { "ordinary_fields": "reject", "custom_fields": "flat_custom_prefix", "notes": "Strictness is an MCP boundary requirement at every depth. Custom fields are flat custom_* properties with any JSON value; the driver's legacy custom_fields container is refused rather than forwarded because TestRail does not read it." },
  "outer_result": { "driver": "array", "tool_data": "array", "notes": "The created cases are returned as an array, unwrapped by the driver from TestRail's cases envelope; entity-field drift is advisory. An unrecognized successful reply is an INVALID_RESPONSE error whose write outcome is unknown, never a retry or a split." },
  "requirements": [
    { "id": "unknown-top-level", "kind": "invalid", "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them." },
    { "id": "unknown-item-field", "kind": "invalid", "description": "Reject an unknown ordinary field in any item rather than forwarding it; only custom_* names extend an item." },
    { "id": "item-identifier-domain", "kind": "invalid", "description": "Hold each item's template, type, priority and milestone identifiers to the identifier domain, exactly as add_case does; a representative zero is refused here." },
    { "id": "legacy-custom-container", "kind": "invalid", "description": "Reject the driver's nested custom_fields object in any item. TestRail reads custom values only as flat custom_* properties, so forwarding the container would drop them silently." },
    { "id": "no-split", "kind": "mapping", "description": "Send exactly one request carrying every item. The adapter never splits the array or retries on its own." }
  ],
  "baseline": "two-cases",
  "parameters": [
    { "id": "section_id", "input_path": ["section_id"], "scope": "path", "requiredness": "required", "domain_ref": "positive_id", "semantics": "No coercion. The section every case is created in; passed positionally and sent verbatim as the only path segment.", "driver": { "argument": 0, "path": [] }, "wire": { "location": "path", "names": ["section_id"], "encoding": "Decimal integer path segment; numeric strings are rejected rather than coerced." }, "sources": ["driver-module", "testrail-cases"] },
    { "id": "body", "input_path": ["body"], "scope": "body", "requiredness": "required", "domain": { "type": "array", "minItems": 1 }, "semantics": "No coercion. The array of case objects is passed as the driver's payload argument; each item accepts exactly the add_case body. The driver wraps the array under cases on the wire.", "driver": { "argument": 1, "path": [] }, "wire": { "location": "json", "names": ["cases"], "encoding": "JSON object { cases: [...] } whose array is the body unchanged." }, "sources": ["driver-module", "driver-schema"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve the array at driver argument 1 and send it under cases." }, { "id": "valid", "kind": "valid", "description": "Accept an array of case objects." }, { "id": "invalid", "kind": "invalid", "description": "Reject a body that is not an array before driver invocation." }, { "id": "empty", "kind": "invalid", "description": "Reject an empty array; the driver refuses it and TestRail answers 400." }, { "id": "required", "kind": "required", "description": "Reject a missing body." } ] },
    { "id": "body[].title", "input_path": ["body", "*", "title"], "scope": "body", "requiredness": "required", "domain": { "type": "string" }, "semantics": "Each item's title, required by TestRail. No coercion.", "driver": { "argument": 1, "path": ["*", "title"] }, "wire": { "location": "json", "names": ["title"], "encoding": "JSON string under title in each item." }, "sources": ["driver-schema", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve each item's title under its own name." }, { "id": "valid", "kind": "valid", "description": "Accept a string in every item." }, { "id": "invalid", "kind": "invalid", "description": "Reject a non-string title in any item before driver invocation." }, { "id": "required", "kind": "required", "description": "Reject an item without a title." } ] },
    { "id": "body[].custom_*", "input_path": ["body", "*", "custom_*"], "scope": "body", "requiredness": "optional", "domain": {}, "semantics": "Any JSON value under a flat custom_ name in any item, which is how TestRail reads custom fields. Values are preserved as given; an ordinary unknown name is rejected rather than passed through.", "driver": { "argument": 1, "path": ["*", "custom_*"] }, "wire": { "location": "json", "names": ["custom_*"], "encoding": "Flat JSON properties retained under their exact names in each item." }, "sources": ["driver-schema", "driver-common", "testrail-cases"], "requirements": [ { "id": "mapping", "kind": "mapping", "description": "Preserve every custom_* property flat in its item." }, { "id": "valid", "kind": "valid", "description": "Accept a string and a null in an item." }, { "id": "invalid", "kind": "invalid", "description": "Reject an ordinary unknown key used in place of a custom_* key." }, { "id": "omitted", "kind": "omitted", "description": "Send no custom properties for an item that supplied none." } ] }
  ],
  "cases": [
    {
      "id": "two-cases", "input": { "section_id": 5, "body": [{ "title": "Print document history", "type_id": 2, "priority_id": 4, "custom_preconds": "These are the preconditions", "custom_null": null }, { "title": "Export as PDF", "estimate": "3m", "labels": [7, "label1"] }] },
