        "driver": { "binding": "cases.addCases", "arguments": [5, [{ "title": "Print document history", "type_id": 2, "priority_id": 4, "custom_preconds": "These are the preconditions", "custom_null": null }, { "title": "Export as PDF", "estimate": "3m", "labels": [7, "label1"] }]] },
        "wire": { "method": "POST", "endpoint": "add_cases/5", "json": { "cases": [{ "title": "Print document history", "type_id": 2, "priority_id": 4, "custom_preconds": "These are the preconditions", "custom_null": null }, { "title": "Export as PDF", "estimate": "3m", "labels": [7, "label1"] }] } },
        "upstream_response": { "kind": "json", "body": { "cases": [{ "id": 42, "title": "Print document history", "section_id": 5, "template_id": 1, "type_id": 2, "priority_id": 4, "milestone_id": 9, "refs": "RF-1, RF-2", "created_by": 1, "created_on": 1646317844, "updated_by": 1, "updated_on": 1646317844, "estimate": "3m", "estimate_forecast": "8m 40s", "suite_id": 3, "display_order": 1, "is_deleted": 0, "custom_preconds": "These are the preconditions", "custom_steps_separated": [{ "content": "Step 1", "expected": "Expected Result 1" }, { "shared_step_id": 3 }], "custom_null": null, "custom_zero": 0, "custom_flag": false, "labels": [{ "id": 7, "title": "label1" }] }, { "id": 43, "title": "Export as PDF", "section_id": 5, "template_id": 1, "type_id": 2, "priority_id": 4, "milestone_id": null, "refs": null, "created_by": 1, "created_on": 1646317900, "updated_by": 1, "updated_on": 1646317900, "estimate": null, "estimate_forecast": null, "suite_id": 3, "display_order": 2, "is_deleted": 0, "custom_preconds": null, "labels": [] }] } },
        "driver_result": { "kind": "json", "value": [{ "id": 42, "title": "Print document history", "section_id": 5, "template_id": 1, "type_id": 2, "priority_id": 4, "milestone_id": 9, "refs": "RF-1, RF-2", "created_by": 1, "created_on": 1646317844, "updated_by": 1, "updated_on": 1646317844, "estimate": "3m", "estimate_forecast": "8m 40s", "suite_id": 3, "display_order": 1, "is_deleted": 0, "custom_preconds": "These are the preconditions", "custom_steps_separated": [{ "content": "Step 1", "expected": "Expected Result 1" }, { "shared_step_id": 3 }], "custom_null": null, "custom_zero": 0, "custom_flag": false, "labels": [{ "id": 7, "title": "label1" }] }, { "id": 43, "title": "Export as PDF", "section_id": 5, "template_id": 1, "type_id": 2, "priority_id": 4, "milestone_id": null, "refs": null, "created_by": 1, "created_on": 1646317900, "updated_by": 1, "updated_on": 1646317900, "estimate": null, "estimate_forecast": null, "suite_id": 3, "display_order": 2, "is_deleted": 0, "custom_preconds": null, "labels": [] }] }
      }
