  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/cases.ts",
      "supports": "addCases validates the section ID, sends it as the only path segment of add_cases, wraps the array as { cases: [...] } in one JSON request, unwraps TestRail's { cases: [...] } reply, and fails closed with a status-200 API error when a successful reply has any other shape, because the write may already have happened. The wire shape is recorded there as confirmed by a live probe on 2026-06-21: a bare array is rejected with 400 'Field :cases is a required field.'"
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/cases.ts",
      "supports": "AddCasesBulkPayloadSchema is an array of AddCasePayloadSchema with at least one item, so each item declares title, template_id, type_id, priority_id, estimate, milestone_id, refs, labels (numbers or strings), is_legacy and a legacy custom_fields record. These are the exported type's declarations; the public method forwards the payload without parsing it, so every payload rule here is enforced at the MCP boundary alone."
    },
    {
      "id": "driver-common",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/common.ts",
      "supports": "zObject uses passthrough, so the declared item type admits unknown and custom_* properties alike; the MCP boundary must reject ordinary unknown names separately."
    },
    {
      "id": "testrail-cases",
      "url": "https://support.testrail.com/hc/en-us/articles/7077292642580-Cases",
      "supports": "The Cases reference documents add_case's fields, which each item of this endpoint follows: title (required), template_id, type_id, priority_id, estimate (a timespan such as 30s or 1m 45s), milestone_id, refs (a comma-separated string), labels (an array of IDs or titles) and is_legacy, plus custom fields submitted with their system name prefixed with custom_. It does not document add_cases itself, so the request shape of the bulk endpoint rests on the driver's live probe rather than on this article."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "flat_custom_prefix",
    "notes": "Strictness is an MCP boundary requirement at every depth, and here it is the only enforcement: the driver forwards this payload without parsing it. Each item accepts exactly the add_case body. Custom fields are flat custom_* properties with any JSON value; the driver's legacy custom_fields container is refused rather than forwarded because TestRail does not read it."
  },
  "outer_result": {
    "driver": "array",
    "tool_data": "array",
    "notes": "The created cases are returned as an array, unwrapped by the driver from TestRail's cases envelope; entity-field drift is advisory. An unrecognized successful reply is an INVALID_RESPONSE error whose write outcome is unknown, never a retry or a split."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-item-field",
      "kind": "invalid",
      "description": "Reject an unknown ordinary field in any item rather than forwarding it; only custom_* names extend an item."
    },
    {
      "id": "legacy-custom-container",
      "kind": "invalid",
      "description": "Reject the driver's nested custom_fields object in any item. TestRail reads custom values only as flat custom_* properties, so forwarding the container would drop them silently."
    },
    {
      "id": "no-split",
      "kind": "mapping",
      "description": "Send exactly one request carrying every item. The adapter never splits the array or retries on its own."
    }
  ],
