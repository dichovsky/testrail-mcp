  "endpoint": {
    "family_id": "T12",
    "http_method": "GET",
    "route": "get_attachment/{attachment_id}",
    "tool": "testrail_get_attachment",
    "driver_method": "attachments.getAttachment"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/a5ccffbfa176e9c6675bd81fff61859bd7b6be5d/src/modules/attachments.ts",
      "supports": "getAttachment validates the number/UUID union, places it as the only path segment of get_attachment and requests the reply as binary, for which the core derives the binaryGet retry policy, resolving with the body as an ArrayBuffer and nothing else."
    },
    {
      "id": "driver-validation",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/a5ccffbfa176e9c6675bd81fff61859bd7b6be5d/src/validation.ts",
      "supports": "validateId accepts any positive integer: it tests Number.isInteger and has no safe-integer bound, so the largest-safe-integer ceiling on these identifiers is this server's own. validateEntryId and validateAttachmentId test strings against one case-insensitive UUID expression anchored at both ends, so a traversal sequence, a surrounding space or a trailing line terminator is refused; validateAttachmentId otherwise accepts any positive integer, with the same missing bound."
    },
    {
      "id": "driver-retry",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/a5ccffbfa176e9c6675bd81fff61859bd7b6be5d/src/retry-policy.ts",
      "supports": "deriveRetryPolicy selects the binaryGet policy for a binary response that is neither a multipart body nor a side-effecting read. It re-sends a download after a 429, any 5xx or a network error, the same failures the default policy retries for a GET."
    },
    {
      "id": "testrail-attachments",
      "url": "https://support.testrail.com/hc/en-us/articles/7077196481428-Attachments",
      "supports": "get_attachment/{attachment_id} requires TestRail 5.7 or later, labels attachment_id an integer, returns the requested file in the body of the response, and answers 400 for an invalid attachment ID and 403 for no access or insufficient permissions. The page also states that TestRail 7.1 (cloud) introduced a new attachment ID format."
    },
    {
      "id": "testrail-introduction",
      "url": "https://support.testrail.com/hc/en-us/articles/7077083596436-Introduction-to-the-TestRail-API",
      "supports": "Before TestRail 7.1 an attachment's ID is the number in its link address; from 7.1 on it is the alphanumeric ID shown on the Attachment Details screen."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement. The destination is never the caller's: the transport writes each download to a new generated name under the configured download directory, so an input naming a path is refused with every other unknown field."
  },
  "outer_result": {
    "driver": "binary",
    "tool_data": "download_metadata",
    "notes": "The driver resolves with the reply's bytes. The transport writes them to a new file under the configured download directory and returns attachment_id as the caller gave it, file_path and the byte count. These fixtures prove the request and the bytes the driver returns; the file handling is proved by the family suite."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields, a caller-chosen download path among them, before driver invocation."
    }
  ],
