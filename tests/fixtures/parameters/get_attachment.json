          }
        ]
      },
      "semantics": "The attachment to download: a positive integer, or a UUID, the format TestRail introduced with release 7.1 (cloud). No coercion: the validated number or string is passed unchanged, and a numeric string is refused rather than read as a number.",
      "driver": {
        "argument": 0,
        "path": []
      },
      "wire": {
        "location": "path",
