  "endpoint": {
    "family_id": "T12",
    "http_method": "POST",
    "route": "add_attachment_to_run/{run_id}",
    "tool": "testrail_add_attachment_to_run",
    "driver_method": "attachments.addAttachmentToRun"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/attachments.ts",
      "supports": "addAttachmentToRun validates the run ID, places it as the only path segment of add_attachment_to_run and posts the file through the shared multipart pipeline with the caller's filename under the none retry policy. It parses no schema, so TestRail's reply is returned as received."
    },
    {
      "id": "driver-validation",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/validation.ts",
      "supports": "validateId accepts a positive safe integer; validateEntryId and validateAttachmentId test strings against one case-insensitive UUID expression anchored at both ends, so a traversal sequence, a surrounding space or a trailing line terminator is refused; validateAttachmentId otherwise accepts only a positive integer."
    },
    {
      "id": "driver-client",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/client-core.ts",
      "supports": "The multipart pipeline appends the file to a FormData under the field name attachment with the caller's filename, and opens the staged path as a blob whose media type is the one supplied or empty when none was. That form data is the request body, sent without a JSON content type, and the none retry policy the upload methods name re-sends nothing, not even a 429, because the body is a consumed stream."
    },
    {
      "id": "driver-constants",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/constants.ts",
      "supports": "MULTIPART_FIELD_NAME is attachment."
    },
    {
      "id": "testrail-attachments",
      "url": "https://support.testrail.com/hc/en-us/articles/7077196481428-Attachments",
      "supports": "add_attachment_to_run/{run_id} requires TestRail 6.3 or later and adds an attachment to a test run. The upload must be multipart/form-data, the maximum upload size is 256MB, and the reply is {\"attachment_id\": 443}. It answers 400 for a malformed request or an invalid run ID and 403 for no access or insufficient permissions."
    },
    {
      "id": "testrail-accessing",
      "url": "https://support.testrail.com/hc/en-us/articles/7077039051284-Accessing-the-TestRail-API",
      "supports": "The documented attachment upload posts the file as the multipart field attachment to add_attachment_to_result/1 and receives {\"attachment_id\":11}."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement. The transport stages an owned copy of the caller's file inside the configured upload roots before dispatch and hands the driver that copy, so the bytes sent are the bytes approved; the staging, its containment, its size limit and its disposal belong to the transport rather than to this endpoint."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "TestRail answers with the new attachment_id, returned as the driver received it: the upload methods parse no schema. Entity drift against the driver's attachment schema is advisory."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "single-request",
      "kind": "mapping",
      "description": "Send exactly one multipart request. The adapter never re-reads the file or repeats the upload."
    }
  ],
