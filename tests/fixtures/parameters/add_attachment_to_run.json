      },
      "semantics": "The caller's path to the file. The transport stages an owned copy within the configured upload roots and the driver receives that copy's path, so this value never reaches TestRail; the file's contents do.",
      "wire": {
        "location": "multipart",
        "names": [
          "attachment"
        ],
        "encoding": "The file's contents become the attachment part's body."
      },
      "sources": [
        "driver-module",
        "driver-client"
      ],
      "requirements": [
        {
          "id": "mapping",
          "kind": "mapping",
          "description": "Pass the staged copy's path as the file argument."
        },
        {
          "id": "valid",
          "kind": "valid",
          "description": "Accept a path and upload that file's contents."
        },
        {
          "id": "invalid",
          "kind": "invalid",
          "description": "Reject a path carrying a control character before driver invocation."
        },
        {
          "id": "required",
          "kind": "required",
          "description": "Reject a missing path."
        }
      ],
      "driver": {
        "argument": 1,
        "path": [
          "path"
        ]
      }
    },
    {
      "id": "filename",
      "input_path": [
        "filename"
      ],
      "scope": "file",
      "requiredness": "required",
      "domain": {
        "type": "string",
        "pattern": "^(?!\\.{1,2}$)(?![A-Za-z]:)[^/\\\\\"\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])"
      },
      "semantics": "The name TestRail records for the attachment. A path separator, a drive prefix, a lone . or .., a control byte and a double quote are refused: the name is not a path, and the encoder percent-escapes a quote, so TestRail would record a name the caller never asked for.",
      "wire": {
        "location": "multipart",
        "names": [
          "attachment"
        ],
        "encoding": "Sent as the attachment part's filename."
      },
      "sources": [
        "driver-module",
        "driver-client"
      ],
      "requirements": [
        {
          "id": "mapping",
          "kind": "mapping",
          "description": "Pass the name as the filename argument and send it as the part's filename."
        },
        {
          "id": "valid",
          "kind": "valid",
          "description": "Accept a plain file name."
        },
        {
          "id": "invalid",
          "kind": "invalid",
          "description": "Reject a name containing a forward or back slash before driver invocation."
        },
        {
          "id": "quote",
          "kind": "invalid",
          "description": "Reject a name containing a double quote, which the multipart encoder percent-escapes, so the recorded name would differ from the one requested."
        },
        {
          "id": "dot-segment",
          "kind": "invalid",
          "description": "Reject a name that is only . or .., which names a directory rather than a file."
        },
        {
          "id": "drive-prefix",
          "kind": "invalid",
          "description": "Reject a name that starts with a drive letter and a colon."
        },
        {
          "id": "control",
          "kind": "invalid",
          "description": "Reject a name carrying a control character."
        },
        {
          "id": "required",
          "kind": "required",
          "description": "Reject a missing name."
        }
      ],
      "driver": {
        "argument": 2,
        "path": []
      }
    },
    {
      "id": "content_type",
      "input_path": [
        "content_type"
      ],
      "scope": "file",
      "requiredness": "optional",
      "domain": {
        "type": "string",
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+/[!#$%&'*+.^_`|~0-9A-Za-z-]+(?: *; *[!#$%&'*+.^_`|~0-9A-Za-z-]+ *= *(?:[!#$%&'*+.^_`|~0-9A-Za-z-]+|\"[^\"]*\"))*(?![\\s\\S])"
      },
      "semantics": "The media type recorded for the part, as a type and subtype with optional parameters. Omitting it leaves the part's type undeclared, which the encoder writes as application/octet-stream; a supplied value becomes the staged copy's type.",
      "wire": {
        "location": "multipart",
        "names": [
          "attachment"
        ],
        "encoding": "Sent as the attachment part's content type. With none supplied the part carries application/octet-stream, which is what the encoder writes for a blob with no declared type."
      },
      "sources": [
        "driver-client"
      ],
      "requirements": [
        {
          "id": "mapping",
          "kind": "mapping",
          "description": "Pass the value as the staged file's type."
        },
        {
          "id": "valid",
          "kind": "valid",
          "description": "Accept a media type and send it on the part."
        },
        {
          "id": "parameter",
          "kind": "valid",
          "description": "Accept a media type with a parameter and send it on the part."
        },
        {
          "id": "invalid",
          "kind": "invalid",
          "description": "Reject a value that is not a media type before driver invocation."
        },
        {
          "id": "omitted",
          "kind": "omitted",
          "description": "Declare no type on the staged copy when the caller supplied none, leaving the encoder's application/octet-stream on the part."
        }
      ],
      "driver": {
        "argument": 1,
        "path": [
          "type"
        ]
      }
    }
