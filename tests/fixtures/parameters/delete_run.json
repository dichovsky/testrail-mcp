  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/runs.ts",
      "supports": "deleteRun validates the run ID, appends soft=1 only when the soft option is true, resolves with no value after a deletion and with the parsed preview after a soft request."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/cases.ts",
      "supports": "SoftDeletePreviewSchema describes the affected_tests, affected_cases, affected_sections, affected_runs, affected_milestones, affected_plans and affected_suites counts, each optional."
    },
    {
      "id": "testrail-runs",
      "url": "https://support.testrail.com/hc/en-us/articles/7077874763156-Runs",
      "supports": "delete_run/{run_id} deletes a run and permanently deletes all its tests and results, and cannot be undone. Omitting soft or sending soft=0 deletes; soft=1 returns data on the number of affected tests and deletes nothing. A run inside a plan is deleted through the plan API instead."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement. No body is sent; the only control is the soft preview flag, and any other query key is a caller mistake."
  },
  "outer_result": {
    "driver": "record_or_void",
    "tool_data": "record_or_null",
    "notes": "After a deletion the method resolves with no value and the wrapper reports data: null. After a preview it resolves with TestRail's affected-entity counts, which are not drift-checked; every count is optional in the driver's schema, so an empty reply to soft=1 is reported as an empty preview. Deletion removes the run's tests and results with it."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-query",
      "kind": "invalid",
      "description": "Reject an unsupported query key rather than discarding it."
    },
    {
      "id": "no-cascade",
      "kind": "mapping",
      "description": "Send exactly one request. The adapter never follows up with further calls, and never reopens or closes the run on the caller's behalf."
    }
  ],
  "baseline": "representative-id",
  "parameters": [
    {
      "id": "run_id",
      "input_path": [
        "run_id"
      ],
      "scope": "path",
      "requiredness": "required",
      "domain_ref": "positive_id",
      "semantics": "No coercion. The validated number is passed positionally and appears verbatim in the path.",
      "driver": {
        "argument": 0,
        "path": []
      },
      "wire": {
        "location": "path",
        "names": [
          "run_id"
