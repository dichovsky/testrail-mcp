      ],
      "scope": "query",
      "requiredness": "optional",
      "domain": {
        "type": "boolean"
      },
      "semantics": "true requests TestRail's server-side preview: the affected counts are returned and nothing is deleted. false or omitted deletes. An explicit false is accepted but never sent, since the driver only ever emits soft=1; TestRail documents soft=0 and an absent soft as equivalent.",
      "driver": {
        "argument": 1,
        "path": [
          "soft"
        ]
      },
      "wire": {
        "location": "query",
        "names": [
          "soft"
        ],
        "encoding": "soft=1 appended path-style when true; nothing is appended when false or omitted."
      },
      "sources": [
        "driver-module",
        "testrail-runs"
      ],
      "requirements": [
        {
          "id": "mapping",
          "kind": "mapping",
          "description": "Preserve the value as the soft option at driver argument 1."
        },
        {
          "id": "valid",
          "kind": "valid",
          "description": "Accept true, send soft=1 and return the preview counts."
        },
        {
          "id": "false-not-sent",
          "kind": "valid",
          "description": "Accept an explicit false, delete, and append nothing to the endpoint."
        },
        {
          "id": "invalid",
          "kind": "invalid",
          "description": "Reject a numeric stand-in for the boolean before driver invocation."
        },
        {
          "id": "omitted",
          "kind": "omitted",
          "description": "Delete, sending no soft control, when the caller did not supply one."
        }
      ]
    }
  ],
