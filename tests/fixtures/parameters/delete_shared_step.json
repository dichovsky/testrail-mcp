  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/sharedSteps.ts",
      "supports": "deleteSharedStep validates the shared-step ID, places it as the only path segment of delete_shared_step and resolves with no value. It sends a JSON body only when the keepInCases option is supplied, converting the boolean to the 1 or 0 TestRail expects; with the option absent no body is sent at all and TestRail's own default applies."
    },
    {
      "id": "testrail-shared-steps",
      "url": "https://support.testrail.com/hc/en-us/articles/7077919815572-Shared-Steps",
      "supports": "delete_shared_step/{shared_step_id} cannot be undone and answers with a 200 and no other data. Its keep_in_cases parameter defaults to 1, which keeps the steps in every case that used the set; submitting 0 removes them from those cases as well. The documented request body is a JSON object carrying that field."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth. The flag is a body field, which is where TestRail documents it, and it is a boolean here: turning it into the 1 or 0 the API expects is the driver's own conversion."
  },
  "outer_result": {
    "driver": "void",
    "tool_data": "null",
    "notes": "The method resolves with no value and the wrapper reports data: null. Deleting a set is irreversible, and deleting it with the flag set to false also strips its steps from every case that used them."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-body",
      "kind": "invalid",
      "description": "Reject an unknown body field rather than forwarding it; the body carries the flag alone."
    },
    {
      "id": "no-cascade",
      "kind": "mapping",
      "description": "Send exactly one request. The adapter never follows up with further calls to find or repair the cases that used the set."
    }
  ],
