  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/projects.ts",
      "supports": "getProjectsPage and getAllProjects share one request preparation that maps isCompleted to the is_completed query control as 1 or 0. The page helper decodes one response; the all helper collects under the safety bounds."
    },
    {
      "id": "driver-paginated-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts",
      "supports": "The page helper validates limit and offset before dispatch and appends them after the filter. The all helper copies only pageSize, startOffset, maxPages, maxItems, maxDurationMs and maxBytes from its options."
    },
    {
      "id": "driver-pagination",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts",
      "supports": "collectAllPages validates every bound as a positive safe integer before the first request, defaults pageSize to 250 and startOffset to 0, requires the first envelope offset to equal startOffset, and stops when _links.next is null."
    },
    {
      "id": "driver-url",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/url.ts",
      "supports": "buildEndpoint appends controls path-style after an ampersand and skips undefined values, so an unfiltered request carries only limit and offset."
    },
    {
      "id": "adapter-limits",
      "url": "https://github.com/dichovsky/testrail-mcp/blob/main/src/contracts/inputs.ts",
      "supports": "aggregateLimitDefaults caps each _mcp bound a caller may request at 1,000 items, 20 pages, 1 MiB and 45,000 ms, and DEFAULT_LIMITS in src/config/limits.ts forwards the same values when the caller sets none."
    },
    {
      "id": "testrail-projects",
      "url": "https://support.testrail.com/hc/en-us/articles/7077792415124-Projects",
      "supports": "get_projects takes is_completed as 1 or 0, limit (250 by default) and offset, and on TestRail 6.7 or later answers with an offset/limit/size/_links envelope around projects."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "Strictness is an MCP boundary requirement at every depth: the top level, query and _mcp are each closed. The two call modes are a union, so a page control in all mode or an aggregate bound in page mode is a caller mistake reported before dispatch rather than a field silently dropped."
  },
  "outer_result": {
    "driver": "page",
    "tool_data": "array",
    "notes": "Page mode returns the driver's decoded page; the wrapper carries its items as data and describes the rest as pagination metadata. All mode returns the collected array. These fixtures use the envelope TestRail 6.7 or later sends; a legacy bare array is decoded as one terminal page."
  },
