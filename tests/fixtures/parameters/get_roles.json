  "sources": [
    {
      "id": "driver-module-metadata",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/metadata.ts",
      "supports": "The roles list is a response-driven paginated executor with request controls disabled: it prepares the get_roles operation with no query at all, so the server chooses each page and the aggregate walks the envelope's next link under the supplied bounds."
    },
    {
      "id": "driver-schema-users",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/users.ts",
      "supports": "UserSchema is the reply shape and is permissive: role_id, is_admin, group_ids and the enterprise fields are all nullish because older servers omit them and get_current_user returns a reduced record, and mfa_required admits an integer because TestRail Cloud wire-encodes it as 0 or 1. UserAddPayloadSchema requires a non-empty name and an email in a dotted-domain format, and declares role_id, group_ids and assigned_projects as positive integers; UserUpdatePayloadSchema makes every field optional. GroupSchema carries id, name and a nullish user_ids. AddGroupPayloadSchema requires name; UpdateGroupPayloadSchema makes it optional and its comment records that TestRail accepts an empty update body. RoleSchema carries id, name, is_default and a nullish is_project_admin."
    },
    {
      "id": "driver-paginated-list",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/paginated-list.ts",
      "supports": "The shared executor issues the page request, and with request controls disabled it sends no limit or offset of its own. The all helper walks the envelope's next link under the supplied bounds."
    },
    {
      "id": "driver-pagination",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/pagination.ts",
      "supports": "The aggregate bounds maxItems, maxPages, maxBytes and maxDurationMs stop the walk and are never serialized upstream."
    },
    {
      "id": "testrail-roles",
      "url": "https://support.testrail.com/hc/en-us/articles/7077853258772-Roles",
      "supports": "get_roles returns an envelope of roles and requires TestRail 7.3 or later. Each role carries id, name and is_default, and is_project_admin on TestRail Enterprise only. The reference documents no request parameter for it."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "The endpoint takes nothing: TestRail documents no parameter for it, and the driver's prepare step sends no query at all. A caller asking to narrow or page it is refused rather than served a list that ignored the request."
  },
  "outer_result": {
    "driver": "page",
    "tool_data": "array",
    "notes": "Page mode returns the server-selected page as the driver decoded it. A role carries is_project_admin on TestRail Enterprise only, which the driver's reply schema admits by making it nullish; entity-field drift is advisory."
  },
