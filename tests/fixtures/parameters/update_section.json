  "endpoint": {
    "family_id": "T01",
    "http_method": "POST",
    "route": "update_section/{section_id}",
    "tool": "testrail_update_section",
    "driver_method": "sections.updateSection"
  },
  "sources": [
    {
      "id": "driver-module",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/modules/sections.ts",
      "supports": "updateSection validates the section ID, places it as the only path segment and sends the payload as the JSON body."
    },
    {
      "id": "driver-schema",
      "url": "https://github.com/dichovsky/testrail-api-client/blob/cc7751c01c3d3956d061073283bee6b23bf33422/src/schemas/sections.ts",
      "supports": "UpdateSectionPayloadSchema leaves name and description optional; it permits additional properties."
    },
    {
      "id": "testrail-sections",
      "url": "https://support.testrail.com/hc/en-us/articles/7077918603412-Sections",
      "supports": "update_section/{section_id} supports partial updates of name and description and returns the updated section in the get_section format; position and parent are changed with move_section."
    }
  ],
  "input_policy": {
    "ordinary_fields": "reject",
    "custom_fields": "reject",
    "notes": "The driver's payload schema permits additional properties; the adapter closes it. A hierarchy field such as parent_id is the likely mistake, since moving belongs to move_section, and is reported rather than forwarded."
  },
  "outer_result": {
    "driver": "record",
    "tool_data": "record",
    "notes": "The updated section is returned. Applying the same field values again leaves the section in the same state, which is why the tool is marked idempotent."
  },
  "requirements": [
    {
      "id": "unknown-top-level",
      "kind": "invalid",
      "description": "Reject unknown top-level fields before driver invocation rather than forwarding or discarding them."
    },
    {
      "id": "unknown-body-field",
      "kind": "invalid",
      "description": "Reject a body field the driver's schema does not declare, which the driver itself would pass through unchecked."
    },
    {
      "id": "body-required",
      "kind": "required",
      "description": "Reject a call without a body key rather than inventing one. An explicitly empty body is the caller's choice and is sent as the partial update TestRail documents."
    }
  ],
  "baseline": "fields-omitted",
  "parameters": [
    {
      "id": "section_id",
      "input_path": ["section_id"],
      "scope": "path",
      "requiredness": "required",
      "domain_ref": "positive_id",
      "semantics": "No coercion. The validated number is passed positionally and appears verbatim in the path.",
      "driver": { "argument": 0, "path": [] },
      "wire": {
        "location": "path",
        "names": ["section_id"],
        "encoding": "Decimal integer path segment; numeric strings are rejected rather than coerced."
      },
      "sources": ["driver-module", "testrail-sections"]
    },
    {
      "id": "body.name",
      "input_path": ["body", "name"],
      "scope": "body",
      "requiredness": "optional",
      "domain": { "type": "string" },
      "semantics": "Sent verbatim when supplied; the current name is kept when omitted. Not trimmed, and an empty string is passed on for TestRail to judge.",
      "driver": { "argument": 1, "path": ["name"] },
      "wire": { "location": "json", "names": ["name"], "encoding": "JSON string in the request body." },
      "sources": ["driver-schema", "testrail-sections"],
      "requirements": [
        { "id": "mapping", "kind": "mapping", "description": "Preserve the value at driver argument 1 under the name key." },
        { "id": "valid", "kind": "valid", "description": "Accept a representative section name." },
        { "id": "invalid", "kind": "invalid", "description": "Reject a non-string name before driver invocation." },
        { "id": "omitted", "kind": "omitted", "description": "Omit the field entirely when the caller did not supply it." }
      ]
    },
    {
      "id": "body.description",
      "input_path": ["body", "description"],
      "scope": "body",
      "requiredness": "optional",
      "domain": { "type": "string" },
      "semantics": "Sent verbatim when supplied. Omitted entirely when absent rather than sent as null.",
      "driver": { "argument": 1, "path": ["description"] },
      "wire": { "location": "json", "names": ["description"], "encoding": "JSON string in the request body." },
      "sources": ["driver-schema", "testrail-sections"],
      "requirements": [
        { "id": "mapping", "kind": "mapping", "description": "Preserve the value at driver argument 1 under the description key." },
        { "id": "valid", "kind": "valid", "description": "Accept a representative description." },
        { "id": "invalid", "kind": "invalid", "description": "Reject a non-string description before driver invocation." },
        { "id": "omitted", "kind": "omitted", "description": "Omit the field entirely when the caller did not supply it." }
      ]
    }
  ],
  "cases": [
    {
      "id": "fields-omitted",
      "input": { "section_id": 5, "body": {} },
      "covers": [
        { "parameter": "section_id", "requirements": ["mapping", "valid"] },
        { "parameter": "body.name", "requirements": ["omitted"] },
        { "parameter": "body.description", "requirements": ["omitted"] }
      ],
      "expect": {
        "kind": "accepted",
        "driver": { "binding": "sections.updateSection", "arguments": [5, {}] },
        "wire": { "method": "POST", "endpoint": "update_section/5", "json": {} },
        "upstream_response": {
          "kind": "json",
          "body": { "id": 5, "suite_id": 3, "name": "Prerequisites", "description": null, "parent_id": null, "display_order": 1, "depth": 0 }
        },
        "driver_result": {
          "kind": "json",
          "value": { "id": 5, "suite_id": 3, "name": "Prerequisites", "description": null, "parent_id": null, "display_order": 1, "depth": 0 }
        }
      }
    },
    {
      "id": "every-field",
      "input": { "section_id": 5, "body": { "name": "A better section name", "description": "Updated description." } },
      "covers": [
        { "parameter": "body.name", "requirements": ["mapping", "valid"] },
        { "parameter": "body.description", "requirements": ["mapping", "valid"] }
      ],
      "expect": {
        "kind": "accepted",
        "driver": { "binding": "sections.updateSection", "arguments": [5, { "name": "A better section name", "description": "Updated description." }] },
        "wire": { "method": "POST", "endpoint": "update_section/5", "json": { "name": "A better section name", "description": "Updated description." } },
        "upstream_response": {
          "kind": "json",
          "body": { "id": 5, "suite_id": 3, "name": "A better section name", "description": "Updated description.", "parent_id": null, "display_order": 1, "depth": 0 }
        },
        "driver_result": {
          "kind": "json",
          "value": { "id": 5, "suite_id": 3, "name": "A better section name", "description": "Updated description.", "parent_id": null, "display_order": 1, "depth": 0 }
        }
      }
    },
    {
      "id": "largest-safe-id",
      "input": { "section_id": 9007199254740991, "body": {} },
      "covers": [{ "parameter": "section_id", "requirements": ["upper-bound"] }],
      "expect": {
        "kind": "accepted",
        "driver": { "binding": "sections.updateSection", "arguments": [9007199254740991, {}] },
        "wire": { "method": "POST", "endpoint": "update_section/9007199254740991", "json": {} },
        "upstream_response": {
          "kind": "json",
          "body": { "id": 9007199254740991, "suite_id": 3, "name": "Boundary section", "description": null, "parent_id": null, "display_order": 2, "depth": 0 }
        },
        "driver_result": {
          "kind": "json",
          "value": { "id": 9007199254740991, "suite_id": 3, "name": "Boundary section", "description": null, "parent_id": null, "display_order": 2, "depth": 0 }
        }
      }
    },
    {
      "id": "missing-body",
      "input": { "section_id": 5 },
      "covers": [{ "parameter": "$input", "requirements": ["body-required"] }],
