{
  "name": "@dichovsky/testrail-mcp",
  "version": "1.0.0",
  "description": "Local stdio MCP server for the TestRail API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dichovsky/testrail-mcp.git"
  },
  "homepage": "https://github.com/dichovsky/testrail-mcp#readme",
  "bugs": {
    "url": "https://github.com/dichovsky/testrail-mcp/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "testrail-mcp": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "typecheck:ts6": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs",
    "registry:check": "node scripts/check-registry.mjs --complete",
    "registry:generate": "npm run build && node scripts/check-registry.mjs --write",
    "check": "npm run build && npm run registry:check && npm run typecheck && npm run typecheck:ts6 && npm run lint && npm test && npm run test:package",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/check-publish.mjs"
  },
  "dependencies": {
    "@dichovsky/testrail-api-client": "9.0.0",
    "@modelcontextprotocol/server": "2.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.3.0",
    "@types/node": "24.19.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
